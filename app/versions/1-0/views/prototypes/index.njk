{% extends "layout.njk" %}

{% set homepage = true %}
{% set mainClasses = "govuk-!-padding-top-0 govuk-!-padding-bottom-0" %}

{% block pageTitle %}
  Teaching Vacancies Service - GOV.UK
{% endblock %}

{% block header %}
  {{ super() }}
  <header class="homepage-header">
    <div class="govuk-width-container">
      <span class="govuk-caption-xl homepage-header__caption">Jobseeker prototype v1.0</span>
      <h1 class="homepage-header__title govuk-!-margin-bottom-0">Teaching Vacancies Service</h1>
      <p class="homepage-header__link">
        <a class="govuk-link" href="https://manage-teaching-jobs-prototype.herokuapp.com/" rel="noopener noreferrer" target="_blank">
          Hiring staff prototype
          <svg class="homepage-header__external" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M14 3h7v7h-2V6.4l-9.3 9.3-1.4-1.4L17.6 5H14V3z"></path>
            <path fill="currentColor" d="M19 19H5V5h7V3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7h-2v7z"></path>
          </svg>
          <span class="govuk-visually-hidden">(opens in new tab)</span>
        </a>
      </p>
    </div>
  </header>
{% endblock %}

{% macro prototypeIcon(icon) %}
  <span class="app-prototype-list__icon" aria-hidden="true">
    {% if icon == "user" %}
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="14" cy="9" r="3.5" stroke="#1d70b8" stroke-width="1.5"></circle>
        <path d="M6.5 21.5c1.1-3.5 3.8-5.5 7.5-5.5s6.4 2 7.5 5.5" stroke="#1d70b8" stroke-width="1.5" stroke-linecap="round"></path>
      </svg>
    {% elif icon == "signed-in" %}
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="11.5" cy="9" r="3.5" stroke="#1d70b8" stroke-width="1.5"></circle>
        <path d="M5 21.5c.9-3.2 3.2-5 6.5-5 1.3 0 2.5.3 3.5.8" stroke="#1d70b8" stroke-width="1.5" stroke-linecap="round"></path>
        <circle cx="20.5" cy="19" r="4.25" stroke="#1d70b8" stroke-width="1.5"></circle>
        <path d="M18.5 19.1l1.3 1.3 2.7-2.8" stroke="#1d70b8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    {% elif icon == "docs" %}
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M8 4.5h8.5L21.5 9.5V23.5H8v-19z" stroke="#1d70b8" stroke-width="1.5" stroke-linejoin="round"></path>
        <path d="M16.5 4.5V9.5H21.5" stroke="#1d70b8" stroke-width="1.5" stroke-linejoin="round"></path>
        <path d="M11 14h7M11 17.5h7M11 21h4.5" stroke="#1d70b8" stroke-width="1.5" stroke-linecap="round"></path>
      </svg>
    {% elif icon == "design" %}
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M16.8 5.4l5.8 5.8L11.2 22.6 4.8 23.2l.6-6.4L16.8 5.4z" stroke="#1d70b8" stroke-width="1.5" stroke-linejoin="round"></path>
        <path d="M14.6 7.6l5.8 5.8" stroke="#1d70b8" stroke-width="1.5"></path>
        <path d="M6.6 19.2l2.4 2.4" stroke="#1d70b8" stroke-width="1.5" stroke-linecap="round"></path>
      </svg>
    {% elif icon == "crown" %}
      <svg width="26" height="24" viewBox="0 0 64 60" fill="#1d70b8" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="20" cy="17.6" r="3.7"></circle>
        <circle cx="10.2" cy="23.5" r="3.7"></circle>
        <circle cx="3.7" cy="33.2" r="3.7"></circle>
        <circle cx="31.7" cy="30.6" r="3.7"></circle>
        <circle cx="43.3" cy="17.6" r="3.7"></circle>
        <circle cx="53.2" cy="23.5" r="3.7"></circle>
        <circle cx="59.7" cy="33.2" r="3.7"></circle>
        <path d="M33.1,9.8c.2-.1.3-.3.5-.5l4.6,2.4v-6.8l-4.6,1.5c-.1-.2-.3-.3-.5-.5l1.9-5.9h-6.7l1.9,5.9c-.2.1-.3.3-.5.5l-4.6-1.5v6.8l4.6-2.4c.1.2.3.3.5.5l-2.6,8c-.9,2.8,1.2,5.7,4.1,5.7h0c3,0,5.1-2.9,4.1-5.7l-2.6-8ZM37,37.9s-3.4,3.8-4.1,6.1c2.2,0,4.2-.5,6.4-2.8l-.7,8.5c-2-2.8-4.4-4.1-5.7-3.8.1,3.1.5,6.7,5.8,7.2,3.7.3,6.7-1.5,7-3.8.4-2.6-2-4.3-3.7-1.6-1.4-4.5,2.4-6.1,4.9-3.2-1.9-4.5-1.8-7.7,2.4-10.9,3,4,2.6,7.3-1.2,11.1,2.4-1.3,6.2,0,4,4.6-1.2-2.8-3.7-2.2-4.2.2-.3,1.7.7,3.7,3,4.2,1.9.3,4.7-.9,7-5.9-1.3,0-2.4.7-3.9,1.7l2.4-8c.6,2.3,1.4,3.7,2.2,4.5.6-1.6.5-2.8,0-5.3l5,1.8c-2.6,3.6-5.2,8.7-7.3,17.5-7.4-1.1-15.7-1.7-24.5-1.7h0c-8.8,0-17.1.6-24.5,1.7-2.1-8.9-4.7-13.9-7.3-17.5l5-1.8c-.5,2.5-.6,3.7,0,5.3.8-.8,1.6-2.3,2.2-4.5l2.4,8c-1.5-1-2.6-1.7-3.9-1.7,2.3,5,5.2,6.2,7,5.9,2.3-.4,3.3-2.4,3-4.2-.5-2.4-3-3.1-4.2-.2-2.2-4.6,1.6-6,4-4.6-3.7-3.7-4.2-7.1-1.2-11.1,4.2,3.2,4.3,6.4,2.4,10.9,2.5-2.8,6.3-1.3,4.9,3.2-1.8-2.7-4.1-1-3.7,1.6.3,2.3,3.3,4.1,7,3.8,5.4-.5,5.7-4.2,5.8-7.2-1.3-.2-3.7,1-5.7,3.8l-.7-8.5c2.2,2.3,4.2,2.7,6.4,2.8-.7-2.3-4.1-6.1-4.1-6.1h10.6,0Z"></path>
      </svg>
    {% elif icon == "devices" %}
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="2" y="5" width="17" height="12" rx="1.5" stroke="#1d70b8" stroke-width="1.5"></rect>
        <path d="M8 14.5h5" stroke="#1d70b8" stroke-width="1.5" stroke-linecap="round"></path>
        <rect x="13" y="10" width="11" height="14" rx="1.5" fill="#ffffff" stroke="#1d70b8" stroke-width="1.5"></rect>
        <path d="M16.5 21.5h4" stroke="#1d70b8" stroke-width="1.5" stroke-linecap="round"></path>
      </svg>
    {% else %}
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="3" y="5" width="16" height="11" rx="1" stroke="#1d70b8" stroke-width="1.5"></rect>
        <path d="M8 20h6M11 16v4" stroke="#1d70b8" stroke-width="1.5"></path>
        <rect x="14" y="12" width="11" height="8" rx="1" stroke="#1d70b8" stroke-width="1.5"></rect>
        <path d="M17.5 23h4" stroke="#1d70b8" stroke-width="1.5"></path>
      </svg>
    {% endif %}
  </span>
{% endmacro %}

{% macro prototypeItem(href, title, meta, icon) %}
  <li class="app-prototype-list__item">
    {{ prototypeIcon(icon) }}
    <div class="app-prototype-list__text">
      <h3 class="app-prototype-list__title">
        <a class="govuk-link" href="{{ href }}">{{ title }}</a>
      </h3>
      <p class="app-prototype-list__meta">{{ meta }}</p>
    </div>
  </li>
{% endmacro %}

{% block content %}
  <div class="app-home">
    <div class="govuk-grid-row govuk-!-margin-top-4">
      <div class="govuk-grid-column-full">
        <section class="app-prototype-index" aria-labelledby="current-version">
          <div class="app-prototype-index__heading-row">
            <h2 class="govuk-heading-m app-prototype-index__heading" id="current-version">Current version v1.0</h2>
            <p class="app-prototype-index__updated">Last updated: <time datetime="2026-10-08">8 October 2026</time></p>
          </div>
          <ul class="app-prototype-list">
            {{ prototypeItem("/home", "Find school and college jobs near you", "The current Teaching Vacancies homepage, search, and job listings.", "user") }}
            {{ prototypeItem("/mobile", "View on mobile and tablet layouts", "Preview the pages on phone and tablet screens.", "devices") }}
            {{ prototypeItem("/signed-in", "View signed in", "Open the prototype as a signed-in user.", "signed-in") }}
          </ul>
        </section>

        <section class="app-prototype-index" aria-labelledby="other-prototypes">
          <h2 class="govuk-heading-m app-prototype-index__heading" id="other-prototypes">Other prototypes</h2>
          <ul class="app-prototype-list">
            {{ prototypeItem("/fe", "Further Education prototype work", "Options for merging, separating, or dedicating further education roles.", "design") }}
          </ul>
        </section>

        <section class="app-prototype-index" aria-labelledby="references">
          <h2 class="govuk-heading-m app-prototype-index__heading" id="references">References</h2>
          <ul class="app-prototype-list">
            {{ prototypeItem("https://tv-design-history.herokuapp.com/", "Teaching Vacancies design history", "Analysis, design and research from the Teaching Vacancies service.", "docs") }}
            {{ prototypeItem("/documentation", "Documentation", "Tech stack, mock JSON, and page flows.", "docs") }}
            {{ prototypeItem("https://design-system.service.gov.uk/components/", "GOV.UK Design System", "Reusable components for building consistent government services.", "crown") }}
            {{ prototypeItem("https://design.education.gov.uk/standards", "DfE design standards", "Principles and guidelines for accessible DfE digital services.", "crown") }}
          </ul>
        </section>
      </div>
    </div>
  </div>
{% endblock %}
