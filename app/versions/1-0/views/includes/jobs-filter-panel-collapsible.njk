                <ul class="app-filter-tags">
                {% if 'Full time' in filterPatterns %}
                    <li><a class="app-filter__tag" href="{{ removeFilterHref('filter-workingPatterns', 'Full time') }}"><span class="govuk-visually-hidden">Remove this filter</span>Full time</a></li>
                {% endif %}
                {% if 'Part time' in filterPatterns %}
                    <li><a class="app-filter__tag" href="{{ removeFilterHref('filter-workingPatterns', 'Part time') }}"><span class="govuk-visually-hidden">Remove this filter</span>Part time</a></li>
                {% endif %}
                {% if 'Job share' in filterPatterns %}
                    <li><a class="app-filter__tag" href="{{ removeFilterHref('filter-workingPatterns', 'Job share') }}"><span class="govuk-visually-hidden">Remove this filter</span>Job share</a></li>
                {% endif %}
                </ul>

            {% endif %}

            {% if filterQuick.length %}

                <h3 class="govuk-heading-s govuk-!-margin-bottom-0">Application method</h3>
                <ul class="app-filter-tags">
                {% if 'Apply online' in filterQuick %}
                    <li><a class="app-filter__tag" href="{{ removeFilterHref('filter-quick', 'Apply online') }}"><span class="govuk-visually-hidden">Remove this filter</span>Only show quick apply jobs</a></li>
                {% endif %}
                </ul>

            {% endif %}


        </div>

    {% endif %}

    <div class="app-filter__options">
      <form id="filter" method="get" action="{{ filterFormAction or '/search/applications' }}" novalidate>
        {{filterOptionsHtml | safe}}
        <button class="govuk-button govuk-!-margin-top-4" data-module="govuk-button" data-prevent-double-click="true" formnovalidate="formnovalidate" type="submit">
          Apply filters
        </button>
      </form>
      <script>
        (function () {
          var storageKey = 'tv-filter-scroll'
          if ('scrollRestoration' in history) history.scrollRestoration = 'manual'

          var saved = sessionStorage.getItem(storageKey)
          if (saved) {
            sessionStorage.removeItem(storageKey)
            try {
              var data = JSON.parse(saved)
              var restore = function () {
                var anchor = data.id && document.getElementById(data.id)
                if (anchor && typeof data.offset === 'number') {
                  window.scrollTo(0, Math.max(0, anchor.getBoundingClientRect().top + window.scrollY - data.offset))
                } else if (typeof data.y === 'number') {
                  window.scrollTo(0, data.y)
                }
              }
              restore()
              window.addEventListener('load', restore)
            } catch (error) {}
          }

          var form = document.getElementById('filter')
          if (!form || form.getAttribute('data-scroll-bound')) return
          form.setAttribute('data-scroll-bound', 'true')
          form.addEventListener('submit', function () {
            var active = document.activeElement
            var anchor = active && active.id ? document.getElementById(active.id) : null
            if (!anchor) anchor = document.getElementById('filter-quick')
            sessionStorage.setItem(storageKey, JSON.stringify({
              id: anchor ? anchor.id : '',
              offset: anchor ? anchor.getBoundingClientRect().top : 0,
              y: window.scrollY
            }))
          })
        })()
      </script>
    </div>
  </div>
</div>

