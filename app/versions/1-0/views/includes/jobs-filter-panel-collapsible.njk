                    <li><a class="app-filter__tag" href="{{ removeFilterHref('filter-international', 'International') }}"><span class="govuk-visually-hidden">Remove this filter</span>Only show jobs with visa sponsorship
                    </a></li>
                {% endif %}
                </ul>

            {% endif %}



