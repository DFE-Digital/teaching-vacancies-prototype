{% extends "layout_email.njk" %}

{% set title = 'You have ' + alerts.length + ' new job matches' %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">
        {{ title }}
      </h1>
      <p class="govuk-body">
        <a class="govuk-link" href="/job-alert-via-email">Filter this list</a>
      </p>

      <ul class="govuk-list">
        {% for alert in alerts %}
          <li>
            <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
            <h2 class="govuk-heading-m govuk-!-margin-bottom-2">
              <a class="govuk-link" href="{{ alert.href }}">{{ alert.title }}</a>
            </h2>
            <p class="govuk-body govuk-!-margin-bottom-1">
              <span class="govuk-visually-hidden">Location: </span>{{ alert.location }}
            </p>
            <p class="govuk-body-s govuk-!-margin-bottom-1">
              <span class="govuk-visually-hidden">Job details: </span>{{ alert.phase }} · {{ alert.contract }} · {{ alert.workingPattern }}{% if alert.hours %}, {{ alert.hours }}{% endif %}
            </p>
            <p class="govuk-body-s govuk-!-margin-bottom-2">
              <span class="govuk-visually-hidden">Salary: </span>{{ alert.salary }}
            </p>
            {% if alert.flags.length %}
              <p class="govuk-body-s govuk-!-font-size-16 govuk-!-margin-bottom-2">
                <span class="govuk-visually-hidden">Role requirements: </span>{{ alert.flags | join(' · ') }}
              </p>
            {% endif %}
          </li>
        {% endfor %}
      </ul>

      <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">

      <h2 class="govuk-heading-m">Your job alert search</h2>
      <p class="govuk-body govuk-!-margin-bottom-1">Keyword: design</p>
      <p class="govuk-body govuk-!-margin-bottom-1">Location: Within 200 miles of London</p>
      <p class="govuk-body govuk-!-margin-bottom-1">Education phases: Secondary school, Sixth form or FE college</p>
      <p class="govuk-body">Working patterns: Full time, Part time, Job share</p>

      <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">

      <h2 class="govuk-heading-m">Are these job listings relevant to your search?</h2>
      <p class="govuk-body govuk-!-margin-bottom-1">
        <a class="govuk-link" href="/jobseeker/job-alert-feedback?answer=yes">Yes, they are relevant</a>
      </p>
      <p class="govuk-body govuk-!-margin-bottom-2">
        <a class="govuk-link" href="/jobseeker/job-alert-feedback?answer=no">No, they are not relevant</a>
      </p>
      <p class="govuk-body">This feedback helps us improve our service.</p>

      <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">

      <p class="govuk-body">
        <a class="govuk-link" href="/">Teaching Vacancies</a> is a free job-listing service from the Department for Education. It helps you find the right jobs and take the next step in your career.
      </p>
      <p class="govuk-body">
        Don’t want to receive these email alerts? <a class="govuk-link" href="/jobseeker/job-alert-unsubscribed">Unsubscribe here</a>
      </p>
    </div>
  </div>
{% endblock %}
