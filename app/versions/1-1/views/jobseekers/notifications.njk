{% extends "layout.njk" %}

{% set title = 'Notifications' %}
{% set activeNav = 'notifications' %}
{% set forceSignedIn = true %}

{% block content %}
  <h1 class="govuk-heading-l">Notifications</h1>
  <p class="govuk-body">Updates about your applications and messages from hiring teams.</p>

  {% if notifications.length %}
    <div class="app-notifications-inbox">
      <p class="app-notifications-inbox__toolbar govuk-!-margin-bottom-0">
        <span class="govuk-!-font-weight-bold">{{ notifications.length }}</span>
        notification{{ "s" if notifications.length != 1 }}
        {% if unreadCount and unreadCount > 0 %}
          (<span class="govuk-!-font-weight-bold">{{ unreadCount }}</span> unread)
        {% endif %}
      </p>
      <ul class="app-notifications-inbox__list">
        {% for item in notifications %}
          <li>
            <a
              class="app-notifications-inbox__row{% if item.unread %} app-notifications-inbox__row--unread{% endif %}"
              href="{{ item.href }}"
            >
              <span class="app-notifications-inbox__date">{{ item.date }}</span>
              <span class="app-notifications-inbox__message">
                <span class="app-notifications-inbox__subject">
                  {% if item.unread %}
                    <span class="app-notifications-inbox__unread-marker" aria-hidden="true"></span>
                    <span class="govuk-visually-hidden">Unread: </span>
                  {% endif %}
                  {{ item.title }}
                </span>
                <span class="app-notifications-inbox__preview">{{ item.body }}</span>
              </span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  {% else %}
    {{ govukInsetText({ text: "You have no notifications yet." }) }}
  {% endif %}
{% endblock %}
