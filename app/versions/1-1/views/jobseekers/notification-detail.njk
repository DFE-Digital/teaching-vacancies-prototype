{% extends "layout.njk" %}

{% set title = notification.title %}
{% set activeNav = 'notifications' %}
{% set forceSignedIn = true %}
{% set recipientEmail = user.emailAddress if user and user.emailAddress else 'your account email' %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back to notifications",
    href: "/jobseekers/notifications"
  }) }}
{% endblock %}

{% block content %}
  <h1 class="govuk-heading-l govuk-!-margin-bottom-2">{{ notification.title }}</h1>
  <p class="govuk-body govuk-!-margin-bottom-6">Received {{ notification.date }}</p>

  <article class="app-notification-message" aria-labelledby="notification-message-subject">
    <dl class="app-notification-message__headers">
      <div class="app-notification-message__header-row">
        <dt>From</dt>
        <dd>{{ notification.detail.from or 'Teaching Vacancies' }}</dd>
      </div>
      <div class="app-notification-message__header-row">
        <dt>To</dt>
        <dd>{{ recipientEmail }}</dd>
      </div>
      <div class="app-notification-message__header-row">
        <dt>Date</dt>
        <dd>{{ notification.date }}</dd>
      </div>
      <div class="app-notification-message__header-row app-notification-message__header-row--subject">
        <dt>Subject</dt>
        <dd id="notification-message-subject">{{ notification.emailSubject }}</dd>
      </div>
    </dl>

    <div class="app-notification-message__body">
      <p class="govuk-body">{{ notification.detail.introduction }}</p>
      {% for paragraph in notification.detail.paragraphs %}
        <p class="govuk-body">{{ paragraph }}</p>
      {% endfor %}
    </div>
  </article>

  <h2 class="govuk-heading-m govuk-!-margin-top-6 govuk-!-margin-bottom-4">About this application</h2>
  <dl class="govuk-summary-list govuk-!-margin-bottom-6">
    {% for row in notification.detail.metadata %}
      <div class="govuk-summary-list__row govuk-summary-list__row--no-actions">
        <dt class="govuk-summary-list__key">{{ row.key }}</dt>
        <dd class="govuk-summary-list__value">
          {% if row.mojBadge %}
            <strong class="moj-badge {{ row.mojBadge }}">{{ row.value }}</strong>
          {% else %}
            {{ row.value }}
          {% endif %}
        </dd>
      </div>
    {% endfor %}
  </dl>

  {{ govukButton({
    text: notification.detail.primaryAction.text,
    href: notification.detail.primaryAction.href
  }) }}
{% endblock %}
