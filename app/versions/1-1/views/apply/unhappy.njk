{% extends "layout.njk" %}

{% set title = "About your application" %}
{% set jobName = job.title if job else "Level 2 teaching assistant" %}
{% set orgName = job.organisation.name if job and job.organisation else "Trent school" %}
{% set visaContinueHref = "/jobs/" + job.id + "/apply" if job else "/jobs" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">
        <span class="govuk-caption-l">{{ jobName }} at {{ orgName }}</span>
        {{ title }}
      </h1>

      {% include "apply/includes/visa-sponsorship-warning.njk" %}
    </div>
  </div>
{% endblock %}
