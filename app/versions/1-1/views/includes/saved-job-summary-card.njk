{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% macro savedJobSummaryCard(job, savedJobState, savedJobSort) %}
  {% set deleteHref = '/onelogin/journey/match?savedJobState=' + (savedJobState or 'saved') + '&savedJobSort=' + savedJobSort + '&deleteJob=' + job.id %}

  <div class="govuk-summary-card govuk-!-margin-bottom-6">
    <div class="govuk-summary-card__title-wrapper">
      <h2 class="govuk-summary-card__title">
        <a class="govuk-link" href="{{ job.href }}">{{ job.title }}</a>
      </h2>
      <ul class="govuk-summary-card__actions">
        <li class="govuk-summary-card__action">
          <a class="govuk-link" href="{{ job.href }}">
            Apply<span class="govuk-visually-hidden"> for {{ job.title }}</span>
          </a>
        </li>
        <li class="govuk-summary-card__action">
          <a class="govuk-link" href="{{ deleteHref }}">
            Delete<span class="govuk-visually-hidden"> saved job {{ job.title }}</span>
          </a>
        </li>
      </ul>
    </div>
    <div class="govuk-summary-card__content">
      {{ govukSummaryList({
        classes: "govuk-!-margin-bottom-0",
        rows: [
          {
            key: { text: "Organisation" },
            value: { text: job.organisation or '—' }
          },
          {
            key: { text: "Location" },
            value: { text: job.location or '—' }
          },
          {
            key: { text: "Date added" },
            value: { text: job.added or '—' }
          },
          {
            key: { text: "Application deadline" },
            value: { text: job.deadline or '—' }
          }
        ]
      }) }}
    </div>
  </div>
{% endmacro %}
