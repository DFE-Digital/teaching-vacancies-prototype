{% from "components/primary-navigation/macro.njk" import appPrimaryNavigation %}
{# MOJ-style primary navigation for signed-in jobseekers (see MOJ Design System primary navigation) #}
{% set personalDetailsActive = accountSection == 'personal-details' %}

{{ appPrimaryNavigation({
  navigationLabel: 'Primary navigation',
  items: [
    {
      text: 'Applications',
      href: '/jobseekers/job_applications',
      active: activeNav == 'applications'
    },
    {
      text: 'Job alerts',
      href: '/jobseekers/subscriptions',
      active: activeNav == 'jobalerts'
    },
    {
      text: 'Notifications',
      href: '/jobseekers/notifications',
      active: activeNav == 'notifications'
    },
    {
      text: 'Personal details',
      href: '/account/personal-details',
      active: personalDetailsActive
    }
  ]
}) }}
