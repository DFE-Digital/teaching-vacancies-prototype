{% extends "layout.njk" %}
{% set primaryNavId = 'jobs' %}
{% set title = job.title if job else "Job" %}

{% if job and job.organisation.type == 'College' %}
  {% set organisationNoun = 'college' %}
{% elif job and job.organisation.type == 'Corporate' %}
  {% set organisationNoun = 'organisation' %}
{% else %}
  {% set organisationNoun = 'school' %}
{% endif %}

{% block head %}
  {{ super() }}
  <style>
    @media (min-width: 40.0625em) {
      .old-design .banner-buttons--v2 > .is-hidden-on-v2 + .govuk-grid-column-one-third {
        margin-left: 33.3333333333%;
      }
    }
  </style>
{% endblock %}

{% block content %}

{% if not job %}
  <h1 class="govuk-heading-l">Job not found</h1>
  <p class="govuk-body"><a class="govuk-link" href="/jobs">Back to jobs</a></p>
{% else %}

  {% set locationCaption %}
    {{ job.organisation.name }}{% if job.organisation.address.town %}, {{ job.organisation.address.town }}{% endif %}{% if job.organisation.address.postcode %}, {{ job.organisation.address.postcode }}{% endif %}
  {% endset %}

  {% if job.jobtype == 'support' %}
    {% set alertHref = '/jobalerts/support' %}
  {% elif data['optionPrototype'] == 'b' %}
    {% set alertHref = '/jobs/fe/jobalert_fe?role-type=fe-role' %}
  {% elif data['optionPrototype'] == 'a' %}
    {% set alertHref = '/alert?role-type=fe-role' %}
  {% else %}
    {% set alertHref = '/jobsfeonly_alert' %}
  {% endif %}

  {% if job.isUsingApplicationForm == 'Yes' %}
    {% if user.profile.provideWork == 'No' %}
      {% set applyHref = '/apply/unhappy' %}
    {% else %}
      {% set applyHref = '/jobs/' + job.id + '/apply' %}
    {% endif %}
    {% set primaryActionText = "Apply for this job" %}
    {% set primaryActionHref = applyHref %}
  {% else %}
    {% set applyHref = '#applying' %}
    {% set primaryActionText = "View advert on external website (opens in new tab)" %}
    {% set primaryActionHref = job.organisation.website or "#" %}
  {% endif %}

  {% set roleText = job.role | join(', ') if job.role and job.role.join else job.role %}

  {% set workingPatternsHtml %}
    {% for workingPattern in job.workingPatterns %}
      <p class="govuk-body govuk-!-margin-bottom-1">
        {{ workingPattern }}{% if workingPattern == 'Full time' and job.fullTimeDetails %}: {{ job.fullTimeDetails }}{% elif workingPattern != 'Full time' and job.partTimeDetails %}: {{ job.partTimeDetails }}{% endif %}
      </p>
    {% endfor %}
  {% endset %}

  {% set visaText %}
    {% if job.sponsorship == 'Skilled Worker visas can be sponsored' or job.sponsorship == 'Skilled worker visa can be sponsored' %}
      Skilled Worker visas can be sponsored
    {% else %}
      Visas cannot be sponsored
    {% endif %}
  {% endset %}

  {% set addressLine %}
    {{ job.organisation.address.address1 }}{% if job.organisation.address.town %}, {{ job.organisation.address.town }}{% endif %}{% if job.organisation.address.postcode %}, {{ job.organisation.address.postcode }}{% endif %}
  {% endset %}

  <div class="vacancies-show old-design">

    {% if flash and flash[0] == 'job-saved' %}
      {{ govukNotificationBanner({
        html: '<p class="govuk-notification-banner__heading">You have saved this job. <a class="govuk-notification-banner__link" href="/onelogin/journey/match">View all your saved jobs</a> on your account.</p>',
        type: "success"
      }) }}
    {% endif %}

    {% set showHeaderAction = query and query.v2 is defined and daysRemaining >= 0 %}
    <div class="{% if showHeaderAction %}vacancies-show__intro{% endif %}">
      <div class="header-with-logo{% if not showHeaderAction %} govuk-!-margin-bottom-5{% endif %}">
        {% if job.organisation.logo and job.organisation.logo != 'Not entered' %}
          <div class="header-with-logo-logo">
            <img src="{{ job.organisation.logo }}" alt="">
          </div>
        {% endif %}
        <div class="header-with-logo-title">
          {% if job.isUsingApplicationForm == 'Yes' %}
            <div class="govuk-!-margin-bottom-2">
              <a class="govuk-tag govuk-tag--green" href="{{ applyHref }}">Quick apply</a>
            </div>
          {% endif %}
          <h1 class="govuk-heading-xl govuk-!-margin-bottom-2">{{ job.title }}</h1>
          <span class="govuk-caption-l govuk-!-margin-top-0">{{ locationCaption }}</span>
          {% set educationPhase = job.phase or job.organisation.phase %}
        </div>
      </div>
    </div>

    <div class="govuk-grid-row banner-buttons{% if showHeaderAction %} banner-buttons--v2{% endif %}">
      {% if daysRemaining >= 0 or data.signedIn or user or forceSignedIn %}
        {% if showHeaderAction %}
          <div class="govuk-grid-column-one-third vacancies-show__banner-apply">
            {% if job.isUsingApplicationForm == 'Yes' %}
              {{ govukButton({
                text: primaryActionText,
                href: primaryActionHref
              }) }}
            {% else %}
              <a class="govuk-button" href="#applying">Apply for this job</a>
            {% endif %}
          </div>
        {% else %}
          <div class="govuk-grid-column-one-third">
            <a class="banner-button-component__button icon icon--left icon--apply" href="{{ applyHref }}">Apply for this job</a>
          </div>
        {% endif %}
      {% endif %}
      <div class="govuk-grid-column-one-third">
        <a class="banner-button-component__button icon icon--left icon--alert-blue" href="{{ alertHref }}">Get a job alert for similar jobs</a>
      </div>
      <div class="govuk-grid-column-one-third">
        {% if (job.id | string) in (data.savedJobs or []) %}
          <span class="banner-button-component__button icon icon--left icon--saved">Job saved</span>
        {% else %}
          <a class="banner-button-component__button icon icon--left icon--save" href="/jobs/{{ job.id }}/save">Save this job for later</a>
        {% endif %}
      </div>
    </div>

    <div class="govuk-grid-row govuk-!-margin-top-6">
      <div class="govuk-grid-column-one-third">
        <div class="timeline-component">
          {% if daysRemaining < 0 %}
            <h2 class="timeline-component__heading govuk-heading-s">This job expired on {{ job.closingDate | date }} – <a class="govuk-link" href="#similar-jobs">see similar jobs</a></h2>
          {% elif daysRemaining == 0 %}
            <h2 class="timeline-component__heading govuk-heading-s">Deadline is today</h2>
          {% else %}
            <h2 class="timeline-component__heading govuk-heading-s">
              {{ daysRemaining }} {{ "day" if daysRemaining == 1 else "days" }} remaining to apply
            </h2>
          {% endif %}

          <ul class="timeline-component__items">
            <li class="timeline-component__item">
              <h3 class="timeline-component__key govuk-heading-s">Start date details</h3>
              <p class="timeline-component__value govuk-body">{{ job.startDate | date }}</p>
            </li>
            <li class="timeline-component__item">
              <h3 class="timeline-component__key govuk-heading-s">Closing date</h3>
              <p class="timeline-component__value govuk-body">{{ job.closingDate | date }} at {{ job.closingTime }}</p>
            </li>
            <li class="timeline-component__item">
              <h3 class="timeline-component__key govuk-heading-s">Date listed</h3>
              <p class="timeline-component__value govuk-body">{{ job.publishDate | date }}</p>
            </li>
          </ul>
        </div>

        {% if job.isUsingApplicationForm == 'Yes' or job.isRoleSuitableForEarlyCareeerTeachers %}
          <div class="sidebar-info-box">
            <h2 class="govuk-heading-s">Help with your personal statement</h2>
            <p class="govuk-body">Use the <a class="govuk-link" href="https://personalstatementbuilder.co.uk/" rel="noreferrer noopener" target="_blank">personal statement builder (opens in new tab)</a> to help you write a personal statement for this job.</p>
          </div>
        {% endif %}
      </div>

      <div class="govuk-grid-column-two-thirds">
        <section id="job-details" class="govuk-!-margin-bottom-5">
          <h2 class="govuk-heading-l heading--border-bottom">Job details</h2>

          {{ govukSummaryList({
            rows: [
              {
                key: { html: '<h3 class="govuk-heading-s govuk-!-margin-bottom-0">Education phase</h3>' },
                value: { text: educationPhase if educationPhase else "Not stated" }
              },
              {
                key: { html: '<h3 class="govuk-heading-s govuk-!-margin-bottom-0">Job role</h3>' },
                value: { html: roleText }
              } if roleText,
              {
                key: { html: '<h3 class="govuk-heading-s govuk-!-margin-bottom-0">Visa sponsorship</h3>' },
                value: { text: visaText }
              },
              {
                key: { html: '<h3 class="govuk-heading-s govuk-!-margin-bottom-0">Key stage</h3>' },
                value: { text: job.keyStages | join(', ') }
              } if job.keyStages and job.keyStages.length,
              {
                key: { html: '<h3 class="govuk-heading-s govuk-!-margin-bottom-0">Subjects</h3>' },
                value: { text: job.subjects | join(', ') }
              } if job.subjects and job.subjects.length,
              {
                key: { html: '<h3 class="govuk-heading-s govuk-!-margin-bottom-0">Working pattern</h3>' },
                value: { html: workingPatternsHtml }
              } if job.workingPatterns,
              {
                key: { html: '<h3 class="govuk-heading-s govuk-!-margin-bottom-0">Contract type</h3>' },
                value: { text: job.contractType if job.contractType else "Not stated" }
              },
              {
                key: { html: '<h3 class="govuk-heading-s govuk-!-margin-bottom-0">Actual salary</h3>' },
                value: { text: job.actualSalaryDetails }
              } if job.actualSalaryDetails,
              {
                key: { html: '<h3 class="govuk-heading-s govuk-!-margin-bottom-0">Pay scale</h3>' },
                value: { text: job.salaryDetails | join(', ') }
              } if job.salaryDetails and job.salaryDetails.length,
              {
                key: { html: '<h3 class="govuk-heading-s govuk-!-margin-bottom-0">Pay scale</h3>' },
                value: { html: job.payScaleDetails }
              } if job.payScaleDetails and not job.salaryDetails
            ]
          }) }}

          {% if job.skillsAndExperience %}
            <h2 class="govuk-heading-m">{{ job.title }} job summary</h2>
            <div class="govuk-body govuk-!-margin-bottom-6">
              {{ job.skillsAndExperience | markdown | safe }}
            </div>
          {% endif %}

          {% if job.whatSchoolOffers %}
            <h2 class="govuk-heading-m">What the {{ organisationNoun }} offers its staff</h2>
            <div class="app-prose govuk-!-margin-bottom-6">
              {{ job.whatSchoolOffers | markdown | safe }}
            </div>
          {% endif %}

          {% if job.hybrid == 'Yes' %}
            <h2 class="govuk-heading-m">Flexible working opportunities</h2>
            <p class="govuk-body">This role can include hybrid working. Contact the {{ organisationNoun }} for the working pattern.</p>
          {% endif %}

          <h2 class="govuk-heading-m">Further information about the job</h2>
          <p class="govuk-body">The candidate will be required to undergo a full enhanced DBS check and must be eligible to work in the UK.</p>
          {{ govukInsetText({
            text: visaText
          }) }}
          <p class="govuk-body">If you’re interested in teaching or training to teach in England as an international citizen, we can help you <a class="govuk-link" href="https://getintoteaching.education.gov.uk/non-uk-teachers">understand your next steps</a>.</p>
          {% if job.hasFurtherDetailsAboutTheRole == 'Yes' and job.furtherDetailsAboutTheRole %}
            <div class="app-prose govuk-!-margin-bottom-6">
              {{ job.furtherDetailsAboutTheRole | markdown | safe }}
            </div>
          {% endif %}

          {% if job.safeguardingCommitment or job.organisation.safeguardingCommitment %}
            <h2 class="govuk-heading-m">Commitment to safeguarding</h2>
            <p class="govuk-body">{{ job.safeguardingCommitment or job.organisation.safeguardingCommitment }}</p>
          {% endif %}

          {% if daysRemaining >= 0 %}
            <h2 class="govuk-heading-m" id="applying">Applying for the job</h2>
            {% if job.isUsingApplicationForm == 'Yes' %}
              <p class="govuk-body">Please complete the online application.</p>
              <p class="govuk-body">CVs will not be accepted for this application.</p>
              {{ govukButton({
                text: primaryActionText,
                href: primaryActionHref
              }) }}
            {% else %}
              <p class="govuk-body">You will leave Teaching Vacancies to apply.</p>
              <p class="govuk-body">{{ job.organisation.name }} asks you to apply on their website. The next step is their application form, not a form on this service.</p>
              <p class="govuk-body">CVs will not be accepted for this application.</p>
              {{ govukButton({
                text: "Apply on the " + job.organisation.name + " website (opens in new tab)",
                href: primaryActionHref,
                attributes: {
                  target: "_blank",
                  rel: "noreferrer noopener"
                }
              }) }}
            {% endif %}
          {% else %}
            {{ govukInsetText({
              text: "This job post has expired.",
              classes: "govuk-!-font-weight-bold"
            }) }}
          {% endif %}

          {% if job.hasAdditionalDocuments == 'Yes' and job.additionalDocuments %}
            <section id="supporting-documents">
              <h2 class="govuk-heading-l heading--border-bottom">Additional documents</h2>
              <p class="govuk-body">If you need these documents in an accessible format, please contact the {{ organisationNoun }}.</p>
              <div class="grey-border-box--thin">
                <ul class="govuk-list">
                  {% for document in job.additionalDocuments %}
                    <li><a class="govuk-link" href="#">{{ document.file }}{% if document.size %}, {{ document.size }}{% endif %} (opens in new tab)</a></li>
                  {% endfor %}
                </ul>
              </div>
            </section>
          {% endif %}
        </section>

        <section id="school-overview">
          <h2 class="govuk-heading-l heading--border-bottom">About {{ job.organisation.name }}</h2>

          {{ govukSummaryList({
            rows: [
              {
                key: { text: "Organisation type" },
                value: { text: job.organisation.type + (", ages " + job.organisation.ageGroup if job.organisation.ageGroup else "") }
              } if job.organisation.type,
              {
                key: { text: "Education phase" },
                value: { text: job.organisation.phase }
              } if job.organisation.phase,
              {
                key: { text: "Size" },
                value: { text: job.organisation.size + (" learners" if organisationNoun == "college" else " pupils enrolled") }
              } if job.organisation.size,
              {
                key: { text: "Age range" },
                value: { text: job.organisation.ageGroup }
              } if job.organisation.ageGroup,
              {
                key: { text: "Ofsted report" },
                value: { html: '<a class="govuk-link" href="https://reports.ofsted.gov.uk/" rel="noreferrer noopener" target="_blank">View Ofsted report (opens in new tab)</a>' }
              } if organisationNoun != "organisation",
              {
                key: { text: "Website" },
                value: { html: '<a class="govuk-link" href="' + job.organisation.website + '" rel="noreferrer noopener" target="_blank">' + job.organisation.name + ' website (opens in new tab)</a>' }
              } if job.organisation.website and job.organisation.website != 'Not entered',
              {
                key: { text: "Email address" },
                value: { html: '<a class="govuk-link" href="mailto:' + job.organisation.emailAddress + '">' + job.organisation.emailAddress + '</a>' }
              } if job.organisation.emailAddress and job.organisation.emailAddress != 'Not entered',
              {
                key: { text: "Phone number" },
                value: { html: '<a class="govuk-link" href="tel:' + job.contactPhoneNumber + '">' + job.contactPhoneNumber + '</a>' }
              } if job.hasContactPhoneNumber == 'Yes' and job.contactPhoneNumber,
              {
                key: { text: "See more jobs" },
                value: { html: '<a class="govuk-link" href="/schools/' + job.organisation.id + '">See all jobs at ' + job.organisation.name + '</a>' }
              }
            ]
          }) }}

          {% if job.organisation.about and job.organisation.about != 'Not entered' %}
            <div class="app-prose govuk-!-margin-bottom-6">
              {{ job.organisation.about | markdown | safe }}
            </div>
          {% endif %}

          {% if job.offersSchoolVisits == 'Yes' %}
            <h3 class="govuk-heading-m">Arrange a visit to {{ job.organisation.name }}</h3>
            <p class="govuk-body">To arrange a visit, email <a class="govuk-link" href="mailto:{{ job.organisation.emailAddress }}">{{ job.organisation.emailAddress }}</a>.</p>
          {% endif %}
        </section>

        <section id="school-location">
          <h2 class="govuk-heading-l heading--border-bottom">
            {% if organisationNoun == 'college' %}College location{% elif organisationNoun == 'organisation' %}Location{% else %}School location{% endif %}
          </h2>
          <p class="govuk-body">{{ addressLine }}</p>
          <h3 class="govuk-heading-m">Travel and commuting</h3>
          <p class="govuk-body">The site postcode is {{ job.organisation.address.postcode }}. Check public transport and driving routes to this postcode before you apply.</p>
          <div class="app-map">
            <img src="/public/images/maps/single.png" alt="Map showing {{ job.organisation.name }}">
          </div>
        </section>

        {% if similarJobs and similarJobs.length %}
          <section class="similar-jobs" id="similar-jobs">
            <h2 class="govuk-heading-m">Similar jobs nearby</h2>
            <div class="govuk-grid-row govuk-!-margin-left-0">
              {% for similarJob in similarJobs %}
                <div class="similar-jobs__job govuk-grid-column-one-half">
                  <p class="govuk-body govuk-!-margin-bottom-1">
                    <a class="govuk-link govuk-link--no-visited-state" href="/jobs/{{ similarJob.id }}">{{ similarJob.title }}</a>
                  </p>
                  {% if similarJob.isUsingApplicationForm == 'Yes' %}
                    <p class="govuk-body govuk-!-margin-bottom-1">
                      <a class="govuk-tag govuk-tag--green" href="/jobs/{{ similarJob.id }}/apply">Quick apply</a>
                    </p>
                  {% endif %}
                  <p class="govuk-body govuk-!-margin-bottom-0 govuk-!-font-weight-bold">{{ similarJob.organisation.name }}</p>
                  <p class="govuk-body govuk-!-margin-bottom-0">
                    {{ similarJob.organisation.address.address1 }}{% if similarJob.organisation.address.town %}, {{ similarJob.organisation.address.town }}{% endif %}{% if similarJob.organisation.address.postcode %}, {{ similarJob.organisation.address.postcode }}{% endif %}
                  </p>
                </div>
              {% endfor %}
            </div>
          </section>
        {% endif %}

        <p class="govuk-body icon icon--left icon--alert-blue">
          <a class="govuk-link" href="{{ alertHref }}">Get a job alert</a> when similar jobs are listed
        </p>
        {% if job.organisation.address.town %}
          <p class="govuk-body icon icon--left icon--map-blue">
            Find more {{ organisationNoun }} jobs in <a class="govuk-link" href="/jobs">{{ job.organisation.address.town }}</a>
          </p>
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}

{% endblock %}
