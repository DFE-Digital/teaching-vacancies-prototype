{% from "includes/version-path.njk" import versionPath %}

{% macro accountHubIcon(icon) %}
  <span class="app-account-featured__icon app-account-featured__icon--{{ icon }}" aria-hidden="true">
    {% if icon == "applications" %}
      {# Briefcase — GOV.UK Featured “Find a job” style #}
      <svg class="app-account-featured__icon-svg" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" focusable="false">
        <path d="M12 10V8.5C12 6.57 13.57 5 15.5 5h1C18.43 5 20 6.57 20 8.5V10h3.5c1.38 0 2.5 1.12 2.5 2.5v12c0 1.38-1.12 2.5-2.5 2.5h-15C9.12 27.5 8 26.38 8 25V12.5C8 11.12 9.12 10 10.5 10H12Zm3 0h2V8.5c0-.83-.67-1.5-1.5-1.5h-1c-.83 0-1.5.67-1.5 1.5V10ZM10.5 18.5h11v1.5h-11v-1.5Z"/>
      </svg>
    {% elif icon == "saved-jobs" %}
      <svg class="app-account-featured__icon-svg" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" focusable="false">
        <path d="M9 6.5c0-1.38 1.12-2.5 2.5-2.5h9c1.38 0 2.5 1.12 2.5 2.5V26l-7-4.2-7 4.2V6.5Zm2.5-.5a.5.5 0 0 0-.5.5v16.2l5.5-3.3 5.5 3.3V6.5a.5.5 0 0 0-.5-.5h-9Z"/>
      </svg>
    {% elif icon == "job-alerts" %}
      <svg class="app-account-featured__icon-svg" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" focusable="false">
        <path d="M16 4.5a7.5 7.5 0 0 0-7.5 7.5v.3c0 1.5-.4 3-1.2 4.3L5.8 19.2c-.5.9.2 2 1.2 2h20c1 0 1.7-1.1 1.2-2l-1.5-2.9a8.4 8.4 0 0 1-1.2-4.3v-.3A7.5 7.5 0 0 0 16 4.5Zm0 22.5a3 3 0 0 0 3-3h-6a3 3 0 0 0 3 3Z"/>
      </svg>
    {% elif icon == "notifications" %}
      {# Message — application updates from hiring teams #}
      <svg class="app-account-featured__icon-svg" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" focusable="false">
        <path d="M7 8h18c1.66 0 3 1.34 3 3v9c0 1.66-1.34 3-3 3h-9.8L9 26.5V23H7c-1.66 0-3-1.34-3-3V11c0-1.66 1.34-3 3-3Zm0 2c-.55 0-1 .45-1 1v9c0 .55.45 1 1 1h3v2.5L14.6 21H25c.55 0 1-.45 1-1V11c0-.55-.45-1-1-1H7Zm4 4.5h10v1.5H11v-1.5Zm0 3.5h7v1.5h-7V18.5Z"/>
      </svg>
    {% elif icon == "personal-details" %}
      {# Person #}
      <svg class="app-account-featured__icon-svg" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" focusable="false">
        <path d="M16 6a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9ZM8.5 24.5c0-4.14 3.36-7.5 7.5-7.5s7.5 3.36 7.5 7.5v1H8.5v-1Z"/>
      </svg>
    {% elif icon == "get-help" %}
      {# Document — GOV.UK Featured guidance style #}
      <svg class="app-account-featured__icon-svg" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" focusable="false">
        <path d="M9 5h11.2L24 8.8V27H9V5Zm11.2 0V9H24L20.2 5ZM11 13h10v1.5H11V13Zm0 4h10v1.5H11V17Zm0 4h7v1.5h-7V21Z"/>
      </svg>
    {% endif %}
  </span>
{% endmacro %}

{% macro accountHubFeaturedItem(href, title, description, icon) %}
  <li class="app-account-featured-list__item">
    <a class="app-account-featured-list__item-link" href="{{ versionPath(href) }}">
      {{ accountHubIcon(icon) }}
      <span class="app-account-featured-list__text">
        <span class="app-account-featured-list__title">{{ title }}</span>
        <span class="app-account-featured-list__description">{{ description }}</span>
      </span>
    </a>
  </li>
{% endmacro %}
