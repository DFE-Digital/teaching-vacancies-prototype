{% extends "layout.njk" %}
{% from "includes/jobseeker-account-hub-macros.njk" import accountHubFeaturedItem %}

{% set title = 'Your account' %}
{% set activeNav = 'account' %}
{% set forceSignedIn = true %}
{% set accountAreaMain = true %}

{% block content %}
  <div class="app-page-header app-account-page-header govuk-!-margin-bottom-4">
    <div class="app-page-header__title">
      <h1 class="govuk-heading-l govuk-!-margin-bottom-0" id="account-heading">Your account</h1>
    </div>
  </div>
  <p class="govuk-body" id="account-intro">Manage applications, job alerts, notifications, personal details and account help in one place.</p>

  <div class="app-account-hub">
    <section class="app-account-featured" aria-labelledby="account-heading" aria-describedby="account-intro">
      <ul class="app-account-featured-list">
        {{ accountHubFeaturedItem('/jobseekers/job_applications', 'Applications', 'View and track jobs you have applied for, including application status.', 'applications') }}
        {{ accountHubFeaturedItem('/jobseekers/saved_jobs?savedJobState=saved', 'Saved jobs', 'Review vacancies you have saved and apply when you are ready.', 'saved-jobs') }}
        {{ accountHubFeaturedItem('/jobseekers/subscriptions', 'Job alerts', 'Create, edit and delete email alerts for new jobs that match your search.', 'job-alerts') }}
        {{ accountHubFeaturedItem('/jobseekers/notifications', 'Notifications', 'Read updates from schools about your applications and other account activity.', 'notifications') }}
        {{ accountHubFeaturedItem('/account/personal-details', 'Profile', 'Update your name, teacher reference number (TRN) and contact email address.', 'personal-details') }}
        {{ accountHubFeaturedItem('/account/your-account', 'Get help', 'Sign-in help, transferring account details, closing your account and email preferences.', 'get-help') }}
        {{ accountHubFeaturedItem('/account/sign-out', 'Sign out', 'Sign out of your Teaching Vacancies account on this device.', 'sign-out') }}
      </ul>
    </section>
  </div>
{% endblock %}
