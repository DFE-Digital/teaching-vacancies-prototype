{% extends "layout.njk" %}
{% from "includes/application-summary-card.njk" import applicationSummaryCard %}
{% from "includes/jobseeker-account-breadcrumbs.njk" import jobseekerAccountBreadcrumbs %}

{% set title = 'Applications' %}
{% set activeNav = 'applications' %}
{% set forceSignedIn = true %}
{% set accountAreaMain = true %}
{% set jobseekerAccountSubNavSection = 'applications' %}

{% block head %}
  {{ super() }}
  <style>
    .app-applications-page-header {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      justify-content: space-between;
      column-gap: 20px;
      row-gap: 15px;
      margin-bottom: 25px;
    }

    .app-applications-page-header__title {
      margin-bottom: 0;
    }

    .app-applications-filter {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      column-gap: 15px;
      row-gap: 0;
      margin-left: auto;
    }

    .app-applications-filter .govuk-form-group {
      margin-bottom: 0;
    }

    .app-applications-filter .govuk-select {
      min-width: 14em;
    }

    .app-applications-filter .govuk-button {
      margin-bottom: 0;
    }

    @media (max-width: 40.0625em) {
      .app-applications-filter {
        width: 100%;
        margin-left: 0;
      }

      .app-applications-filter .govuk-form-group {
        margin-bottom: 10px;
      }

      .app-applications-filter .govuk-select {
        width: 100%;
        min-width: 0;
      }
    }

    .app-applications__pagination .govuk-pagination {
      margin-top: 40px;
    }
  </style>
{% endblock %}

{% block content %}
  {{ jobseekerAccountBreadcrumbs("Applications") }}
  {% include "includes/job-applications-page-header.njk" %}

  <div class="app-applications-page-header">
    <h2 class="govuk-heading-m app-applications-page-header__title govuk-!-margin-top-0">Applications ({{ applicationCount }})</h2>

    <form method="get" action="/jobseekers/job_applications" class="app-applications-filter">
      {{ govukSelect({
        id: "status",
        name: "status",
        label: {
          text: "Filter by status",
          classes: "govuk-label--s"
        },
        items: statusFilterItems
      }) }}
      {{ govukButton({
        text: "Apply filter",
        classes: "govuk-button--secondary"
      }) }}
    </form>
  </div>

  <div class="app-applications">
    {% if applications.length %}
      {% for application in applications %}
        {{ applicationSummaryCard(application) }}
      {% endfor %}
    {% else %}
      {{ govukInsetText({
        text: "No applications match this filter. Select Show all and apply the filter to see every application."
      }) }}
    {% endif %}
  </div>

  {% if pageCount > 1 %}
    <div class="app-applications__pagination">
      {{ govukPagination({
        previous: {
          href: previousHref
        } if previousHref,
        next: {
          href: nextHref
        } if nextHref,
        items: paginationItems
      }) }}
    </div>
  {% endif %}

  {{ govukDetails({
    classes: "govuk-!-margin-top-7",
    summaryText: "Can't see your applications?",
    html: '<p class="govuk-body">If your Teaching Vacancies account used a different email address from your GOV.UK One Login account, your applications will not automatically appear here.</p><p class="govuk-body">You can request <a class="govuk-link" href="/onelogin/journey/import">a transfer of your existing profile</a>.</p>'
  }) }}
{% endblock %}
