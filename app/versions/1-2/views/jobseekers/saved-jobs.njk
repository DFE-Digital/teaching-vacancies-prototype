{% extends "layout.njk" %}
{% from "includes/saved-job-summary-card.njk" import savedJobSummaryCard %}
{% from "includes/jobseeker-account-breadcrumbs.njk" import jobseekerAccountBreadcrumbs %}

{% set title = 'Saved jobs' %}
{% set showSavedJobsToggle = true %}
{% set activeNav = 'applications' %}
{% set forceSignedIn = true %}
{% set accountAreaMain = true %}

{% block head %}
  {{ super() }}
  <style>
    .app-saved-jobs-empty {
      margin-bottom: 30px;
      padding: 25px 20px 15px;
      border: 3px dashed #b1b4b6;
      background: #f8f8f8;
    }

    .app-saved-jobs-empty .govuk-heading-m {
      margin-bottom: 15px;
    }

    .app-saved-jobs-heading {
      margin-bottom: 15px;
    }

    .app-saved-jobs-sort {
      margin-bottom: 25px;
    }

    .app-saved-jobs-sort__sep {
      display: inline-block;
      margin: 0 10px;
    }

    .app-saved-jobs-sort--select {
      display: none;
      max-width: 100%;
    }

    .app-saved-jobs-sort--select .govuk-form-group {
      margin-bottom: 0;
    }

    @media (max-width: 40.0625em) {
      .app-saved-jobs-sort--links {
        display: none;
      }

      .app-saved-jobs-sort--select {
        display: block;
      }
    }

    .app-saved-jobs-help {
      margin-top: 15px;
      margin-bottom: 0;
    }

    .app-state-toggle {
      margin: 0 0 10px;
      font-size: 14px;
      line-height: 1.4;
    }

    .app-state-toggle a[aria-current="true"] {
      font-weight: bold;
      text-decoration: none;
      pointer-events: none;
    }
  </style>
{% endblock %}

{% block content %}
  {% set savedJobCount = savedJobList.length if savedJobList else 0 %}

  {{ jobseekerAccountBreadcrumbs("Saved jobs") }}
  {% include "includes/saved-jobs-page-header.njk" %}

  <h2 class="govuk-heading-m app-saved-jobs-heading govuk-!-margin-top-0">Saved jobs ({{ savedJobCount }})</h2>

  {% if savedJobList and savedJobList.length %}
    {% set savedJobStateParam = data.savedJobState or 'saved' %}

    <form method="get" action="/jobseekers/saved_jobs" class="app-saved-jobs-sort app-saved-jobs-sort--select">
      <input type="hidden" name="savedJobState" value="{{ savedJobStateParam }}">
      {{ govukSelect({
        label: { text: "Sort by" },
        id: "savedJobSort",
        name: "savedJobSort",
        attributes: { onchange: "this.form.submit()" },
        items: [
          { value: "added", text: "Date added (most recent)", selected: savedJobSort == 'added' },
          { value: "deadline", text: "Application deadline (soonest)", selected: savedJobSort == 'deadline' },
          { value: "title", text: "Job title (a to z)", selected: savedJobSort == 'title' }
        ]
      }) }}
    </form>

    <p class="govuk-body app-saved-jobs-sort app-saved-jobs-sort--links">
      <span class="govuk-!-font-weight-bold">Sort by:</span>
      {% if savedJobSort == 'added' %}
        <span class="govuk-!-font-weight-bold">Date added (most recent)</span>
      {% else %}
        <a class="govuk-link" href="/jobseekers/saved_jobs?savedJobState={{ savedJobStateParam }}&amp;savedJobSort=added">Date added (most recent)</a>
      {% endif %}<span class="app-saved-jobs-sort__sep" aria-hidden="true">|</span>
      {%- if savedJobSort == 'deadline' %}
        <span class="govuk-!-font-weight-bold">Application deadline (soonest)</span>
      {% else %}
        <a class="govuk-link" href="/jobseekers/saved_jobs?savedJobState={{ savedJobStateParam }}&amp;savedJobSort=deadline">Application deadline (soonest)</a>
      {% endif %}<span class="app-saved-jobs-sort__sep" aria-hidden="true">|</span>
      {%- if savedJobSort == 'title' %}
        <span class="govuk-!-font-weight-bold">Job title (a to z)</span>
      {% else %}
        <a class="govuk-link" href="/jobseekers/saved_jobs?savedJobState={{ savedJobStateParam }}&amp;savedJobSort=title">Job title (a to z)</a>
      {% endif %}
    </p>

    {% for job in savedJobList %}
      {{ savedJobSummaryCard(job, data.savedJobState, savedJobSort) }}
    {% endfor %}
  {% else %}
    <div class="app-saved-jobs-empty">
      <h2 class="govuk-heading-m">You have no saved jobs</h2>
      <p class="govuk-body"><a class="govuk-link" href="/home">Find jobs</a> and save the ones you want to review or apply for later.</p>
    </div>
  {% endif %}

  {{ govukDetails({
    classes: "app-saved-jobs-help",
    summaryText: "Can't see your saved jobs?",
    html: '<p class="govuk-body">If your Teaching Vacancies account used a different email address from your GOV.UK One Login account, your saved jobs will not automatically appear here.</p><p class="govuk-body">You can request <a class="govuk-link" href="/onelogin/journey/import">a transfer of your existing profile</a>.</p>'
  }) }}
{% endblock %}
