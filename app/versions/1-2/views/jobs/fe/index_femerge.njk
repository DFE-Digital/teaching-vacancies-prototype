
{% extends "layout.njk" %}

{% block pageTitle %}
 240 jobs found sorted by newest job - Find a job in teaching - Teaching Vacancies - GOV.UK
{% endblock %}

{% set primaryNavId = 'jobs' %}
{% set activeNav = 'jobs' %}
{% set filterFormAction = filterFormAction or '/femerge' %}
{% set clearFiltersHref = clearFiltersHref or '/femerge/clear-filters' %}
{% set showFeSubjects = showFeSubjects or true %}

{% block head %}
  {{ super() }}
  <style>
    .app-search-sort {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 20px;
      margin: 10px 0 20px;
      padding-bottom: 15px;
      border-bottom: 1px solid #b1b4b6;
    }

    .app-search-sort .govuk-heading-m {
      margin-bottom: 0;
    }

    .app-filter-layout .app-jobs__item .header-with-logo-title .govuk-tag {
      font-size: 16px;
      font-size: 1rem;
      line-height: 1.25;
    }

    .app-filter-layout .app-search-form {
      background-color: #f3f3f3;
    }

    .app-filter-layout .app-search-form .govuk-button {
      font-size: 19px;
      font-size: 1.1875rem;
      line-height: 1;
      width: 11.5rem;
      height: 40px;
      height: 2.5rem;
    }

    @media (min-width: 40.0625em) {
      .app-filter-layout .app-search-form .govuk-button {
        width: 13.65625rem;
      }
    }

    .app-results-heading {
      align-items: center;
      display: flex;
      gap: 15px;
      justify-content: space-between;
    }

    .app-results-heading .govuk-heading-l {
      margin-bottom: 0;
    }

    .app-results-heading .app-action-bar__filter {
      float: none;
      margin-bottom: 0;
      width: auto;
    }

    .app-results-heading .app-show-filter {
      margin-bottom: 0;
    }

    .app-action-bar__filter .govuk-button {
      width: auto;
    }
  </style>
{% endblock %}

{% block content %}
  <div class="app-results-heading govuk-!-margin-bottom-6">
    <h1 class="govuk-heading-l">
      Jobs (341)
    </h1>
    <div class="app-action-bar">
      <div class="app-action-bar__filter"></div>
    </div>
  </div>

  <div class="app-jobs-listing">
  {# Descoped: job alert promo on search results #}
  {% include "includes/jobs-search-form-details.njk" %}

  <div class="app-filter-layout">
    <div class="app-filter-layout__filter">

      {% if data['filtertype'] == '1' %}

        {% include "includes/jobs-filter-panel-collapsible.njk" %}

      {% elseif data['filtertype'] == '2' %}

        {% include "includes/jobs-filter-panel.njk" %}

      {% else %}

        {% include "includes/jobs-filter-panel-collapsible.njk" %}

      {% endif %}

    </div>


    <div class="app-filter-layout__content">
      {% include "includes/jobs-search-form.njk" %}

      <div>
        <div class="app-jobs">

          {% if data['sort'] == 'newest' %}
            {% set currentSort = 'newest' %}
          {% else %}
            {% set currentSort = 'ending' %}
          {% endif %}

          <div class="app-search-sort">
            <h2 class="govuk-heading-m">
              {% if currentSort == 'newest' %}
                Sorted by newest job
              {% else %}
                Sorted by ending soon
              {% endif %}
            </h2>
            <form id="sortform" method="get" action="/femerge" data-sort-stay="true">
              <div class="govuk-form-group govuk-!-margin-bottom-0">
                <label class="govuk-label" for="sort">Sort by</label>
                <select class="govuk-select" id="sort" name="sort">
                  <option value="ending" {% if currentSort == 'ending' %}selected{% endif %}>Ending soon</option>
                  <option value="newest" {% if currentSort == 'newest' %}selected{% endif %}>Newest job</option>
                </select>
              </div>
            </form>
          </div>

        {% if currentSort == 'newest' %}
          {% set job_list = jobs|sort(attribute='publishDate', reverse=true) %}
        {% else %}
          {% set job_list = jobs|sort(attribute='closingDate', reverse=false) %}
        {% endif %}

        {% for job in job_list %}

          {% if loop.index0 < 10 %}

            {% include "includes/job-listing-item.njk" %}

          {% endif %}
        {% endfor %}
      </div>

      {{ govukPagination({
          next: {
            href: "#"
          },
          items: [
            {
              number: 1,
              href: "#",
              current: true
            },
            {
              number: 2,
              href: "#"
            },
            {
              number: 3,
              href: "#"
            }
          ]
        }) }}
    </div>
  </div>
  </div>

  {# {{ govukDetails({
    summaryText: "Jobs by school, role, location and subject",
    text: "Text",
    classes: 'govuk-!-margin-top-8 govuk-!-margin-bottom-0'
  }) }} #}

{% endblock %}

{% block pageScripts %}
  <script src="/public/javascripts/components/filter-toggle-button/filter-toggle-button.js"></script>
  <script>
    new AppFrontend.FilterToggleButton({
      bigModeMediaQuery: '(min-width: 48.063em)',
      startHidden: false,
      toggleButton: {
        container: $('.app-action-bar__filter'),
        showText: 'Show filter',
        hideText: 'Hide filter',
        classes: 'app-show-filter govuk-!-margin-bottom-3'
      },
      closeButton: {
        container: $('.app-filter__header-action'),
        text: 'Close'
      },
      filter: {
        container: $('.app-filter-layout__filter')
      }
    })

    new AppFrontend.CheckboxFilter({
      container: $('#subjects'),
      textBox: {
        label: 'Search for subject'
      }
    })

    var shownJobs = document.querySelectorAll('.app-jobs .app-jobs__item').length
    if (shownJobs > 0) {
      var jobsListing = document.querySelector('.app-jobs-listing')
      if (jobsListing) jobsListing.classList.add('app-jobs-listing--has-results')
    }
  </script>
{% endblock %}
