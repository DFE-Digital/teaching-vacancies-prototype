{% extends "layout.njk" %}
{% from "apply/flow/includes/heading.njk" import applicationHeading, completedSection with context %}
{% set title = "Professional body memberships" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{ applicationHeading() }}
      <h2 class="govuk-heading-l">Professional body memberships (optional)</h2>
      <p class="govuk-body">You can add professional body memberships, such as the Chartered College of Teaching or the General Teaching Council.</p>

      {% if application.memberships | length %}
        {% for item in application.memberships %}
          <div class="govuk-summary-card govuk-!-margin-bottom-6">
            <div class="govuk-summary-card__title-wrapper">
              <h3 class="govuk-summary-card__title">{{ item.name or "Membership" }}</h3>
              <ul class="govuk-summary-card__actions">
                <li class="govuk-summary-card__action">
                  <a class="govuk-link" href="/jobs/{{ job.id }}/apply/memberships/{{ item.id }}/edit">Change<span class="govuk-visually-hidden"> {{ item.name }}</span></a>
                </li>
                <li class="govuk-summary-card__action">
                  <a class="govuk-link" href="/jobs/{{ job.id }}/apply/memberships/{{ item.id }}/delete">Delete<span class="govuk-visually-hidden"> {{ item.name }}</span></a>
                </li>
              </ul>
            </div>
            <div class="govuk-summary-card__content">
              {{ govukSummaryList({
                classes: "govuk-!-margin-bottom-0",
                rows: [
                  { key: { text: "Name of professional body" }, value: { text: item.name } },
                  { key: { text: "Membership type or level" }, value: { text: item.type or "Not provided" } },
                  { key: { text: "Membership or registration number" }, value: { text: item.number or "Not provided" } },
                  { key: { text: "Date you joined" }, value: { text: item.joined or "Not provided" } },
                  { key: { text: "Did you take an exam to get this membership?" }, value: { text: item.exam or "Not provided" } }
                ]
              }) }}
            </div>
          </div>
        {% endfor %}
        <p class="govuk-body">
          <a class="govuk-button" href="/jobs/{{ job.id }}/apply/memberships/new" role="button" data-module="govuk-button">Add another membership</a>
        </p>
      {% else %}
        <div class="app-empty-section">
          <h3 class="govuk-heading-s">No memberships added</h3>
          <a class="govuk-button" href="/jobs/{{ job.id }}/apply/memberships/new" role="button" data-module="govuk-button">Add a membership</a>
        </div>
      {% endif %}

      <form method="post">
        {{ completedSection("memberships") }}
      </form>
    </div>
  </div>
{% endblock %}
