<div class="app-jobs__item">
  <div class="app-jobs__item-save" data-job-id="{{ job.id }}">
    {% if (job.id | string) in (data.savedJobs or []) %}
      <a class="banner-button-component__button icon icon--saved app-jobs__item-save-control" data-unsave-job href="/jobs/{{ job.id }}/unsave" aria-label="Remove the job from saved jobs"></a>
    {% else %}
      <a class="banner-button-component__button icon icon--save app-jobs__item-save-control" data-save-job href="/jobs/{{ job.id }}/save" aria-label="Save the job for later"></a>
    {% endif %}
  </div>

  <div class="header-with-logo">
    <div class="header-with-logo-title">
      {% if job.isUsingApplicationForm == 'Yes' %}
        <p class="app-jobs__quick-apply-wrap govuk-!-margin-bottom-1 govuk-!-margin-top-0">
          <strong class="govuk-tag govuk-tag--green app-jobs__quick-apply">Quick apply</strong>
        </p>
      {% endif %}
      <h2 class="govuk-heading-m app-jobs__title govuk-!-margin-bottom-2">
        <a class="govuk-link" href="/jobs/{{ job.id }}">{{ job.title }}</a>
      </h2>
    </div>
  </div>

  <p class="app-jobs__item__roles" style="display:none;">{{ job.role }}</p>

  <div class="app-jobs__listing-with-logo">
    {% if job.organisation.logo and job.organisation.logo != 'Not entered' %}
      <div class="app-jobs__listing-logo">
        <img src="{{ job.organisation.logo }}" alt="">
      </div>
    {% endif %}
    <div class="app-jobs__listing-lines">
      {% include "includes/job-listing-compact-lines.njk" %}
    </div>
  </div>
</div>
