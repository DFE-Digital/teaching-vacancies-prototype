{% set closingInformation %}
  {{ job.closingDate | date }}{% if job.closingTime %} at {{ job.closingTime }}{% endif %}
{% endset %}

{% set listingAddress = job | jobListingAddress %}
{% set listingSchoolType = job | jobListingSchoolType %}
{% set listingSalaryFull = job | jobListingSalaryFull %}
{% set listingSalary = job | jobListingSalary %}
{% set listingSalaryLabel = job | jobListingSalaryLabel %}
{% set listingPayScale = job | jobListingPayScale %}
{% set resultPhase = job.phase or job.organisation.phase %}
{% set visaText %}
  {% if job.sponsorship %}
    {{ job.sponsorship }}
  {% else %}
    Visas cannot be sponsored
  {% endif %}
{% endset %}

{% set listingSalaryDisplay %}
  {% if listingSalaryFull != listingSalary %}
    <span class="app-jobs__salary" title="{{ listingSalaryFull }}">{{ listingSalary if listingSalary else "Not provided" }}</span>
  {% else %}
    <span class="app-jobs__salary">{{ listingSalary if listingSalary else "Not provided" }}</span>
  {% endif %}
{% endset %}

<div class="app-jobs__item">
  <div class="header-with-logo">
    <div class="header-with-logo-title">
      <h2 class="govuk-heading-m app-jobs__title">
        <a class="govuk-link" href="/jobs/{{ job.id }}">{{ job.title }}</a>
        {% if job.isUsingApplicationForm == 'Yes' %}
          <strong class="govuk-tag govuk-tag--green app-jobs__quick-apply">Quick apply</strong>
        {% endif %}
      </h2>
      {% if listingAddress %}
        <p class="app-jobs__address govuk-body govuk-!-margin-bottom-0">{{ listingAddress }}</p>
      {% endif %}
    </div>
    {% if job.organisation.logo and job.organisation.logo != 'Not entered' %}
      <div class="header-with-logo-logo--search-result">
        <img src="{{ job.organisation.logo }}" alt="">
      </div>
    {% endif %}
  </div>

  <p class="app-jobs__item__roles" style="display:none;">{{ job.role }}</p>

  {{ govukSummaryList({
    classes: 'govuk-summary-list--no-border app-summary-list--compact',
    rows: [
      {
        key: { text: listingSalaryLabel },
        value: { html: listingSalaryDisplay }
      },
      {
        key: { text: "Working pattern" },
        value: { text: job.workingPatterns | join(', ') | capitalize }
      } if job.workingPatterns and job.workingPatterns.length,
      {
        key: { text: "School type" },
        value: { text: listingSchoolType }
      } if listingSchoolType,
      {
        key: { text: "Education phase" },
        value: { text: resultPhase if resultPhase else "Not stated" }
      },
      {
        key: { text: "Contract type" },
        value: { text: job.contractType if job.contractType else "Not stated" }
      },
      {
        key: { text: "Pay scale" },
        value: { text: listingPayScale }
      } if listingPayScale,
      {
        key: { text: "Early career teachers" },
        value: { text: "Suitable" if job.isRoleSuitableForEarlyCareeerTeachers == "Yes" else "Not suitable" }
      } if job.isRoleSuitableForEarlyCareeerTeachers,
      {
        key: { text: "Overseas qualifications" },
        value: { text: "Accepted" if job.acceptsOverseasQualifications == "Yes" else "Not accepted" }
      } if job.acceptsOverseasQualifications,
      {
        key: { text: "Driving" },
        value: { text: "Required" if job.drivingRequired == "Yes" else "Not required" }
      } if job.drivingRequired,
      {
        key: { text: "Location" },
        value: { text: job.distance + ' miles from you' }
      } if job.distance,
      {
        key: { text: "Closing date" },
        value: { html: closingInformation }
      } if job.closingDate,
      {
        key: { text: "Visa sponsorship" },
        value: { text: visaText | trim }
      }
    ]
  }) }}
</div>
