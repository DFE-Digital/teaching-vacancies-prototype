{% from "govuk/components/tag/macro.njk" import govukTag %}

{% macro applicationSummaryCard(application) %}
  {% set viewHref = application.href or ('/jobs/' + application.id) %}
  {% set actionText = 'Continue application' if application.status == 'Draft' else 'View application' %}

  <div class="govuk-summary-card govuk-!-margin-bottom-6">
    <div class="govuk-summary-card__title-wrapper">
      <h2 class="govuk-summary-card__title">
        <a class="govuk-link" href="{{ viewHref }}">{{ application.title }} {{ application.reference }}</a>
      </h2>
      <ul class="govuk-summary-card__actions">
        <li class="govuk-summary-card__action">
          <a class="govuk-link" href="{{ viewHref }}">
            {{ actionText }}<span class="govuk-visually-hidden"> for {{ application.title }}</span>
          </a>
        </li>
      </ul>
    </div>
    <div class="govuk-summary-card__content">
      <dl class="govuk-summary-list govuk-!-margin-bottom-0">
        <div class="govuk-summary-list__row govuk-summary-list__row--no-actions">
          <dt class="govuk-summary-list__key">Status</dt>
          <dd class="govuk-summary-list__value">
            {{ govukTag({ text: application.status, classes: application.tagClass }) }}
          </dd>
        </div>
        <div class="govuk-summary-list__row govuk-summary-list__row--no-actions">
          <dt class="govuk-summary-list__key">Organisation</dt>
          <dd class="govuk-summary-list__value">{{ application.organisation or '—' }}</dd>
        </div>
        {% if application.activity %}
          <div class="govuk-summary-list__row govuk-summary-list__row--no-actions">
            <dt class="govuk-summary-list__key">Activity</dt>
            <dd class="govuk-summary-list__value">{{ application.activity }}</dd>
          </div>
        {% endif %}
        <div class="govuk-summary-list__row govuk-summary-list__row--no-actions">
          <dt class="govuk-summary-list__key">Closing date</dt>
          <dd class="govuk-summary-list__value">{{ application.closingDate or '—' }}</dd>
        </div>
      </dl>
    </div>
  </div>
{% endmacro %}
