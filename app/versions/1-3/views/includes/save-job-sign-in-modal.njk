<div class="govuk-modal-dialogue" id="save-job-sign-in-modal" data-inert-container=".govuk-modal-dialogue-inert-container">
  <div class="govuk-modal-dialogue__wrapper">
    <dialog class="govuk-modal-dialogue__box" aria-labelledby="save-job-sign-in-modal-title" aria-modal="true" role="dialog" tabindex="-1">
      <div class="govuk-modal-dialogue__header">
        <button type="button" class="govuk-button govuk-modal-dialogue__close" aria-label="Close" data-element="govuk-modal-dialogue-close">×</button>
      </div>
      <div class="govuk-modal-dialogue__content">
        <h2 class="govuk-modal-dialogue__heading govuk-heading-l" id="save-job-sign-in-modal-title">
          Save this job for later
        </h2>
        <div class="govuk-modal-dialogue__description govuk-body" id="save-job-sign-in-modal-description">
          <p class="govuk-!-margin-bottom-4">
            You need to sign in or create a jobseeker account to save and apply for jobs.
          </p>
        </div>
        <div class="govuk-button-group govuk-!-margin-top-5">
          <a class="govuk-button" href="{{ signInHref or '/account/sign-in' }}" data-module="govuk-button" data-save-job-sign-in-link="sign-in">Sign in</a>
          <a class="govuk-button govuk-button--secondary" href="{{ jobseekerSignInHref or '/account/sign-in/jobseeker' }}" data-module="govuk-button" data-save-job-sign-in-link="jobseeker">Create an account</a>
        </div>
        <p class="govuk-body govuk-!-margin-bottom-0">
          <a class="govuk-link" href="#" data-element="govuk-modal-dialogue-close">Cancel</a>
        </p>
      </div>
    </dialog>
  </div>
  <div class="govuk-modal-dialogue__backdrop"></div>
</div>
