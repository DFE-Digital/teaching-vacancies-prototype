{% extends "layout.njk" %}

{% set title = 'Add your details' %}
{% set primaryNavId = 'account' %}
{% set forceSignedIn = true %}
{% set errors = errors or {} %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% if errorList and errorList.length %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorList
        }) }}
      {% endif %}

      <h1 class="govuk-heading-l">{{ title }}</h1>

      <p class="govuk-body">
        We use your name in job applications and in emails about your applications and job alerts. We use your postcode to suggest jobs near you.
      </p>

      <form method="post" action="/account/add-your-details" class="app-profile-capture-form" novalidate>
        {{ govukInput({
          label: { text: "First name", classes: "govuk-label--m" },
          id: "firstName",
          name: "firstName",
          value: firstName,
          autocomplete: "off",
          errorMessage: { text: errors.firstName } if errors.firstName
        }) }}

        {{ govukInput({
          label: { text: "Last name", classes: "govuk-label--m" },
          id: "lastName",
          name: "lastName",
          value: lastName,
          autocomplete: "off",
          errorMessage: { text: errors.lastName } if errors.lastName
        }) }}

        {{ govukInput({
          label: { text: "Phone number (optional)", classes: "govuk-label--m" },
          id: "phoneNumber",
          name: "phoneNumber",
          value: phoneNumber,
          classes: "govuk-input--width-20",
          type: "tel",
          autocomplete: "tel",
          errorMessage: { text: errors.phoneNumber } if errors.phoneNumber
        }) }}

        {{ govukInput({
          label: { text: "Postcode (optional)", classes: "govuk-label--m" },
          id: "postcode",
          name: "postcode",
          value: postcode,
          classes: "govuk-input--width-10",
          autocomplete: "postal-code",
          errorMessage: { text: errors.postcode } if errors.postcode
        }) }}

        {{ govukInput({
          label: { text: "Teacher reference number (optional)", classes: "govuk-label--m" },
          hint: {
            html: 'Your TRN is 7 digits long. <a class="govuk-link" href="https://find-a-lost-trn.education.gov.uk/start" target="_blank" rel="noreferrer noopener">Look up your TRN (opens in a new tab)</a> if you do not know it.'
          },
          id: "trn",
          name: "trn",
          value: trn,
          classes: "govuk-input--width-10",
          autocomplete: "off",
          errorMessage: { text: errors.trn } if errors.trn,
          attributes: { inputmode: "numeric", pattern: "[0-9]{7}", maxlength: "7" }
        }) }}

        {{ govukButton({
          text: "Save and continue",
          classes: "govuk-!-margin-top-4"
        }) }}
      </form>
    </div>
  </div>
{% endblock %}
