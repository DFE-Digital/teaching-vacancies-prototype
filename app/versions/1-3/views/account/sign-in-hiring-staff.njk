{% extends "layout.njk" %}

{% set title = 'Hiring staff sign-in' %}
{% set contentPage = true %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l govuk-!-margin-bottom-4">Hiring staff sign-in</h1>
      <p class="govuk-body govuk-!-margin-bottom-0">Use DfE Sign-in to access your Teaching Vacancies account.</p>

      <h2 class="govuk-heading-m govuk-!-margin-top-6">Get a Teaching Vacancies account</h2>
      <p class="govuk-body govuk-!-margin-bottom-0">Create a DfE Sign-in account or log in to your existing one, then select ‘Request access to a service’ and choose Teaching Vacancies.</p>

      <h2 class="govuk-heading-m govuk-!-margin-top-6">List a role at trust or local authority level</h2>
      <p class="govuk-body govuk-!-margin-bottom-6">To list a role across multiple schools or at trust or local authority level, you need to make sure you have the right level of access. Continue to DfE Sign-in and select ‘Request access to an organisation’.</p>

      {{ govukButton({
        text: "Continue to DfE Sign-in",
        href: "https://services.signin.education.gov.uk/",
        attributes: {
          target: "_blank",
          rel: "noopener noreferrer"
        }
      }) }}
    </div>
  </div>
{% endblock %}
