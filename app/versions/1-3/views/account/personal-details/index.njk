{% extends "layout.njk" %}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}
{% from "includes/version-path.njk" import versionPath %}
{% from "includes/jobseeker-account-sub-nav.njk" import jobseekerAccountSubNav %}

{% set primaryNavId = 'account' %}
{% set accountSection = 'personal-details' %}
{% set forceSignedIn = true %}
{% set title = 'Profile' %}
{% set accountAreaMain = true %}
{% set showDateOfBirthCard = false %}
{% set showNationalInsuranceCard = false %}

{% block content %}
  {{ govukBreadcrumbs({
    classes: "govuk-!-display-none-print govuk-breadcrumbs--collapse-on-mobile govuk-!-margin-bottom-4",
    items: [
      {
        text: "Your account",
        href: versionPath("/jobseekers/account")
      },
      {
        text: "Profile"
      }
    ]
  }) }}

  {% if captureComplete %}
    {{ govukNotificationBanner({
      type: "success",
      text: "Your details have been saved"
    }) }}
  {% endif %}

  {{ jobseekerAccountSubNav('profile') }}

  {% include "includes/account-page-header.njk" %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {% if nameUpdated %}
        {{ govukNotificationBanner({ type: "success", text: "Your name has been updated" }) }}
      {% endif %}
      {% if trnUpdated %}
        {{ govukNotificationBanner({ type: "success", text: "Your TRN has been updated" }) }}
      {% endif %}
      {% if showDateOfBirthCard and dateOfBirthUpdated %}
        {{ govukNotificationBanner({ type: "success", text: "Your date of birth has been updated" }) }}
      {% endif %}
      {% if showNationalInsuranceCard and niUpdated %}
        {{ govukNotificationBanner({ type: "success", text: "Your National Insurance number has been updated" }) }}
      {% endif %}
      {% if townOrPostcodeUpdated %}
        {{ govukNotificationBanner({ type: "success", text: "Your location has been updated" }) }}
      {% endif %}
      {% if phoneUpdated %}
        {{ govukNotificationBanner({ type: "success", text: "Your phone number has been updated" }) }}
      {% endif %}

      <div class="govuk-summary-card govuk-!-margin-bottom-6">
        <div class="govuk-summary-card__title-wrapper">
          <h2 class="govuk-summary-card__title">Your full name</h2>
          <ul class="govuk-summary-card__actions">
            <li class="govuk-summary-card__action">
              <a class="govuk-link" href="/account/personal-details/name">Change<span class="govuk-visually-hidden"> your full name</span></a>
            </li>
          </ul>
        </div>
        <div class="govuk-summary-card__content">
          {{ govukSummaryList({
            classes: "govuk-!-margin-bottom-0",
            rows: [
              {
                key: { text: "First name" },
                value: { text: user.profile.firstName or '—' }
              },
              {
                key: { text: "Last name" },
                value: { text: user.profile.lastName or '—' }
              }
            ]
          }) }}
        </div>
      </div>

      {% if showDateOfBirthCard %}
      <div class="govuk-summary-card govuk-!-margin-bottom-6">
        <div class="govuk-summary-card__title-wrapper">
          <h2 class="govuk-summary-card__title">Date of birth</h2>
          <ul class="govuk-summary-card__actions">
            <li class="govuk-summary-card__action">
              <a class="govuk-link" href="/account/personal-details/date-of-birth">Change<span class="govuk-visually-hidden"> date of birth</span></a>
            </li>
          </ul>
        </div>
        <div class="govuk-summary-card__content">
          {{ govukSummaryList({
            classes: "govuk-!-margin-bottom-0",
            rows: [
              {
                key: { text: "Date of birth" },
                value: { text: dateOfBirthDisplay }
              }
            ]
          }) }}
        </div>
      </div>
      {% endif %}

      {% if showNationalInsuranceCard %}
      <div class="govuk-summary-card govuk-!-margin-bottom-6">
        <div class="govuk-summary-card__title-wrapper">
          <h2 class="govuk-summary-card__title">National Insurance number</h2>
          <ul class="govuk-summary-card__actions">
            <li class="govuk-summary-card__action">
              <a class="govuk-link" href="/account/personal-details/national-insurance-number">Change<span class="govuk-visually-hidden"> National Insurance number</span></a>
            </li>
          </ul>
        </div>
        <div class="govuk-summary-card__content">
          {{ govukSummaryList({
            classes: "govuk-!-margin-bottom-0",
            rows: [
              {
                key: { text: "National Insurance number" },
                value: { text: niDisplay }
              }
            ]
          }) }}
        </div>
      </div>
      {% endif %}

      <div class="govuk-summary-card govuk-!-margin-bottom-6">
        <div class="govuk-summary-card__title-wrapper">
          <h2 class="govuk-summary-card__title">Your location for vacancy suggestions</h2>
          <ul class="govuk-summary-card__actions">
            <li class="govuk-summary-card__action">
              <a class="govuk-link" href="/account/personal-details/town-or-postcode">Change<span class="govuk-visually-hidden"> your location for vacancy suggestions</span></a>
            </li>
          </ul>
        </div>
        <div class="govuk-summary-card__content">
          {{ govukSummaryList({
            classes: "govuk-!-margin-bottom-0",
            rows: [
              {
                key: { text: "Postcode" },
                value: { text: postcodeDisplay }
              }
            ]
          }) }}
        </div>
      </div>

      <div class="govuk-summary-card govuk-!-margin-bottom-6">
        <div class="govuk-summary-card__title-wrapper">
          <h2 class="govuk-summary-card__title">Your contact details</h2>
        </div>
        <div class="govuk-summary-card__content">
          {{ govukSummaryList({
            classes: "govuk-!-margin-bottom-0",
            rows: [
              {
                key: { text: "Phone number" },
                value: { text: user.profile.phoneNumber or 'Not provided' },
                actions: {
                  items: [
                    {
                      href: "/account/personal-details/phone-number",
                      text: "Change",
                      visuallyHiddenText: "phone number"
                    }
                  ]
                }
              },
              {
                key: { text: "Email address" },
                value: { text: user.emailAddress or '—' }
              }
            ]
          }) }}
          <hr class="govuk-section-break govuk-section-break--visible govuk-section-break--m govuk-!-margin-top-4 govuk-!-margin-bottom-4">
          <p class="govuk-body govuk-!-margin-bottom-0">You change your email address in GOV.UK One Login. Updates will apply when you next sign in to Teaching Vacancies.</p>
          <p class="govuk-body govuk-!-margin-bottom-0 govuk-!-margin-top-2">
            <a class="govuk-link" href="https://home.account.gov.uk/settings" rel="noopener noreferrer" target="_blank">
              GOV.UK One Login (opens in a new tab)
            </a>
          </p>
        </div>
      </div>

      <div class="govuk-summary-card govuk-!-margin-bottom-6">
        <div class="govuk-summary-card__title-wrapper">
          <h2 class="govuk-summary-card__title">Your teacher reference number</h2>
          <ul class="govuk-summary-card__actions">
            <li class="govuk-summary-card__action">
              <a class="govuk-link" href="/account/personal-details/trn">Change<span class="govuk-visually-hidden"> your teacher reference number</span></a>
            </li>
          </ul>
        </div>
        <div class="govuk-summary-card__content">
          {{ govukSummaryList({
            classes: "govuk-!-margin-bottom-0",
            rows: [
              {
                key: { text: "TRN" },
                value: { text: trnDisplay }
              }
            ]
          }) }}
        </div>
      </div>
    </div>
  </div>
{% endblock %}
