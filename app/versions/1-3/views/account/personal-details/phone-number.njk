{% extends "layout.njk" %}

{% set primaryNavId = 'account' %}
{% set accountSection = 'personal-details' %}
{% set title = 'Change your phone number' %}
{% set errors = errors or {} %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{ govukBackLink({ text: "Back to profile", href: "/account/personal-details" }) }}

      {% if errorList and errorList.length %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorList
        }) }}
      {% endif %}

      <h1 class="govuk-heading-l">{{ title }}</h1>
      <p class="govuk-body">Enter a phone number schools and hiring staff can use to contact you about your applications.</p>

      <form method="post" action="/account/personal-details/phone-number" novalidate>
        {{ govukInput({
          label: { text: "Phone number", classes: "govuk-label--m" },
          id: "phoneNumber",
          name: "phoneNumber",
          value: phoneNumber,
          classes: "govuk-input--width-20",
          type: "tel",
          autocomplete: "tel",
          hint: {
            text: "For example 01632 960 001, 07700 900 982 or +44 0808 157 0192"
          },
          errorMessage: { text: errors.phoneNumber } if errors.phoneNumber
        }) }}
        {{ govukButton({ text: "Save changes" }) }}
      </form>
    </div>
  </div>
{% endblock %}
