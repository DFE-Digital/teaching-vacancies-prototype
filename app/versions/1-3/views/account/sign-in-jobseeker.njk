{% extends "layout.njk" %}

{% set title = 'Jobseeker sign-in' %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">Jobseeker sign-in</h1>

      {% set signInFrom = signInFrom or (query.from if query and query.from else '') %}
      {% if signInFrom == 'savejob' %}
        <p class="govuk-body">You need to sign in to save this job.</p>
      {% elif signInFrom == 'applyjob' %}
        <p class="govuk-body">You need to sign in to apply for this job.</p>
      {% elif signInFrom == 'savealert' %}
        <p class="govuk-body">You need to sign in to create a job alert.</p>
      {% endif %}

      <p class="govuk-body">
        Use GOV.UK One Login to sign in to Teaching Vacancies. You can create an account if you do not already have one.
      </p>

      {{ govukButton({
        text: "Sign in",
        href: oneLoginStartHref or "/onelogin/start"
      }) }}
    </div>
  </div>
{% endblock %}
