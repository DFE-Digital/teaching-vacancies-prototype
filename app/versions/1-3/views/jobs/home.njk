{% extends "layout.njk" %}

{% block pageTitle %}
  Teaching, leadership and support jobs - Teaching Vacancies - GOV.UK
{% endblock %}

{% set primaryNavId = 'home' %}
{% set mainClasses = "govuk-main-wrapper--auto-spacing govuk-!-padding-top-2" %}

{% macro jobLink(label, count) %}
  <li>
    <a class="govuk-link govuk-link--no-visited-state" href="#">{{ label }} ({{ count }})</a>
  </li>
{% endmacro %}

{% macro placeLink(label, count, heading) %}
  {% if heading %}
    <h3 class="govuk-heading-s govuk-!-margin-bottom-2">
      <a class="govuk-link govuk-link--no-visited-state" href="#">{{ label }}<span class="govuk-visually-hidden"> jobs</span></a><span aria-hidden="true"> ({{ count }})</span>
    </h3>
  {% else %}
    <li>
      <a class="govuk-link govuk-link--no-visited-state" href="#">{{ label }}<span class="govuk-visually-hidden"> jobs</span></a><span aria-hidden="true"> ({{ count }})</span>
    </li>
  {% endif %}
{% endmacro %}

{% block content %}

{{ govukNotificationBanner({
    html: '<p class="govuk-notification-banner__heading">' + flash + '</p>',
    type: "success"
  }) if flash and flash.length }}

<div class="home_index home_index--hero-v2">

    <header class="home-hero__page-header search__inner">
      <div class="home-hero__page-title">
        <h1 class="home-hero__title" id="home-hero-title">Find school and college jobs near you</h1>
      </div>
      <p class="home-hero__subtitle">Search teaching, leadership and support roles in schools and colleges in England</p>
    </header>

    <section class="search home-hero" aria-labelledby="home-hero-title">
      <div class="search__inner home-hero__panel-wrap">
        <div class="home-hero__panel">
          <form id="filter" class="home" method="get" action="/search/home" novalidate>
            <div class="search__form">
              <div class="search__field">
                <div class="govuk-form-group">
                  <label class="govuk-label home-hero__search-label" for="keyword-field">What</label>
                  <div class="govuk-hint home-hero__search-hint" id="keyword-field-hint">Enter job title, skill or keywords</div>
                  <input class="govuk-input" id="keyword-field" name="keywords" type="text" autocomplete="off" aria-describedby="keyword-field-hint">
                </div>
              </div>
              <div class="search__field">
                <div class="govuk-form-group">
                  <label class="govuk-label home-hero__search-label" for="location-field">Where</label>
                  <div class="govuk-hint home-hero__search-hint" id="location-field-hint">Enter a postcode, town or region</div>
                  <input class="govuk-input" id="location-field" name="location" type="text" autocomplete="off" aria-describedby="location-field-hint">
                </div>
              </div>
            </div>
            <div class="search__submit home-hero__search-submit">
              {{ govukButton({
                text: "Search",
                preventDoubleClick: true,
                attributes: {
                  formnovalidate: "formnovalidate"
                }
              }) }}
            </div>
            <div class="home-hero__panel-extra">
              {{ govukDetails({
                summaryText: "Popular keyword searches",
                classes: "home-hero__popular-details govuk-!-margin-bottom-0",
                html: '
                  <div class="search__popular">
                    <a class="govuk-link govuk-link--no-visited-state" href="/search/applications?keywords=Primary">Primary</a>
                    <a class="govuk-link govuk-link--no-visited-state" href="/search/applications?keywords=Maths">Maths</a>
                    <a class="govuk-link govuk-link--no-visited-state" href="/search/applications?keywords=Science">Science</a>
                    <a class="govuk-link govuk-link--no-visited-state" href="/search/applications?keywords=Teaching%20Assistant">Teaching Assistant</a>
                    <a class="govuk-link govuk-link--no-visited-state" href="/search/applications?keywords=Headteacher">Headteacher</a>
                  </div>
                '
              }) }}
            </div>
          </form>
        </div>
      </div>
    </section>

    <div class="home_index__promos govuk-!-margin-top-6">
      <h2 class="govuk-heading-m">For jobseekers</h2>
      <p class="govuk-body">Save and apply for jobs in schools and colleges.</p>
      <p class="govuk-body govuk-!-margin-bottom-0"><a class="govuk-link govuk-link--no-visited-state" href="/account/sign-in">Sign in</a> or <a class="govuk-link govuk-link--no-visited-state" href="/account/sign-in/jobseeker">Create an account</a>.</p>
    </div>

    <div class="landing-page-links">
      {% set landingAccordionExtraClass = 'home-landing-accordion' %}
      {% include "includes/home-landing-accordion.njk" %}
    </div>

    <div class="home_index__promos home_index__promos--hiring-staff govuk-!-margin-top-6">
      <h2 class="govuk-heading-m">For hiring staff</h2>
      <p class="govuk-body">Post your jobs and manage applications.</p>
      <p class="govuk-body govuk-!-margin-bottom-0"><a class="govuk-link govuk-link--no-visited-state" href="/account/sign-in/hiring-staff">Sign in</a> or <a class="govuk-link govuk-link--no-visited-state" href="/account/sign-in/hiring-staff">Create an account</a>.</p>
    </div>

    <p class="govuk-body home_index__browse-all govuk-!-margin-top-6 govuk-!-margin-bottom-0">
      <a class="govuk-link govuk-link--no-visited-state govuk-!-font-size-19" href="/jobs">Browse all school and college jobs in England</a>
    </p>

</div>

{% endblock %}
