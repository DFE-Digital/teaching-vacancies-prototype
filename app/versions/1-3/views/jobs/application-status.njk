{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">

      <p class="govuk-caption-m">Update application status</p>
      <h1 class="govuk-heading-l govuk-!-margin-bottom-6">
        {{ title }}
      </h1>

      <div class="govuk-inset-text govuk-!-margin-bottom-6">
        <p class="govuk-!-font-weight-bold govuk-!-margin-bottom-2">Applicants</p>
        <ul class="govuk-list govuk-list--bullet govuk-!-margin-bottom-0">
          <li>jane doe</li>
        </ul>
      </div>

      <form method="post" novalidate id="application-status-form">
        <div class="govuk-form-group">
          <fieldset class="govuk-fieldset">
            <legend class="govuk-fieldset__legend govuk-fieldset__legend--l govuk-!-margin-bottom-4">
              <span class="govuk-visually-hidden">{{ title }}</span>
            </legend>

            <div class="govuk-radios" data-module="govuk-radios" id="application-status-radios">
              <div class="govuk-radios__item">
                <input class="govuk-radios__input" id="application-status-not-progressing" name="applicationStatus" type="radio" value="not-progressing">
                <label class="govuk-label govuk-radios__label" for="application-status-not-progressing">
                  Not progressing
                  <span class="govuk-tag govuk-tag--red app-status-badge">Not progressing</span>
                </label>
                <div class="govuk-hint govuk-radios__hint app-radio-hint app-radio-hint--hidden" id="application-status-not-progressing-hint">
                  You cannot undo this action after you select save and continue
                </div>
              </div>

              <div class="govuk-radios__item">
                <input class="govuk-radios__input" id="application-status-shortlisted" name="applicationStatus" type="radio" value="shortlisted">
                <label class="govuk-label govuk-radios__label" for="application-status-shortlisted">
                  Shortlisted
                  <span class="govuk-tag govuk-tag--yellow app-status-badge">Shortlisted</span>
                </label>
                <div class="govuk-hint govuk-radios__hint" id="application-status-shortlisted-hint">
                  Applications that have been shortlisted.
                </div>
              </div>

              <div class="govuk-radios__item">
                <input class="govuk-radios__input" id="application-status-interviewing" name="applicationStatus" type="radio" value="interviewing">
                <label class="govuk-label govuk-radios__label" for="application-status-interviewing">
                  Interviewing
                  <span class="govuk-tag govuk-tag--turquoise app-status-badge">Interviewing</span>
                </label>
                <div class="govuk-hint govuk-radios__hint" id="application-status-interviewing-hint">
                  Candidates you plan to interview. You will also be able to trigger pre-interview checks through Teaching Vacancies.
                </div>
              </div>

              <p class="govuk-body govuk-!-margin-top-1 govuk-!-margin-bottom-3">or</p>

              <div class="govuk-radios__item">
                <input class="govuk-radios__input" id="application-status-job-offered" name="applicationStatus" type="radio" value="job-offered">
                <label class="govuk-label govuk-radios__label" for="application-status-job-offered">
                  Job offered
                  <span class="govuk-tag govuk-tag--turquoise app-status-badge">Job offered</span>
                </label>
                <div class="govuk-hint govuk-radios__hint" id="application-status-job-offered-hint">
                  Candidates that have been offered a job. If they decline an offer you can update the status later.
                </div>
              </div>
            </div>
          </fieldset>
        </div>

        <div class="govuk-button-group">
          {{ govukButton({
            text: "Save and continue"
          }) }}

          {{ govukButton({
            text: "Cancel",
            classes: "govuk-button--secondary",
            href: "/jobs/download-app-job-example-loggedin-filledin"
          }) }}
        </div>
      </form>

    </div>
  </div>
{% endblock %}

{% block pageScripts %}
  <script>
    (function () {
      var form = document.getElementById('application-status-form');

      if (!form) {
        return;
      }

      var radioGroup = form.querySelector('.govuk-radios');
      var notProgressingRadio = document.getElementById('application-status-not-progressing');
      var notProgressingHint = document.getElementById('application-status-not-progressing-hint');

      function syncNotProgressingHint () {
        if (!notProgressingRadio || !notProgressingHint) {
          return;
        }

        notProgressingHint.classList.toggle('app-radio-hint--hidden', !notProgressingRadio.checked);
      }

      syncNotProgressingHint();

      radioGroup.addEventListener('change', function (event) {
        if (event.target && event.target.matches('input[type="radio"]')) {
          syncNotProgressingHint();
        }
      });
    })();
  </script>
  <style>
    .app-status-badge {
      margin-left: 8px;
      vertical-align: middle;
      white-space: nowrap;
    }

    .app-status-badge,
    .app-status-badge:hover,
    .app-status-badge:visited {
      text-decoration: none;
    }

    .app-radio-hint {
      border-left: 4px solid #b1b4b6;
      margin-left: 17px;
      margin-top: 4px;
      padding-left: 16px;
    }

    .app-radio-hint--hidden {
      display: none !important;
    }
  </style>
{% endblock %}
