{% extends "layout.njk" %}

{% set primaryNavId = 'jobs' %}
{% set title = 'What application status do you want to assign to this applicant?' %}

{% block pageTitle %}
  {{ title }} - Teaching Vacancies - GOV.UK
{% endblock %}

{% block header %}
  {% if user %}

    {% set navigationItems = [{
        href: "/profile",
        text: "Your profile",
        active: primaryNavId == 'profile'
      },
      {
        href: "/account",
        text: "Your account",
        active: primaryNavId == 'account'
      }, {
        href: "/account/sign-out",
        text: "Sign out"
      }]
    %}

  {% else %}
    {% set navigationItems = [{
        href: "/account/new",
        text: "Create account"
      }, {
        href: "/account/sign-in",
        text: "Sign in"
      }]
    %}

  {% endif %}

