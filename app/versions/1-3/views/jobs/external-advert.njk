{% extends "layout.njk" %}

{% set primaryNavId = 'jobs' %}
{% set title = "External job advert" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <div class="govuk-!-padding-6 govuk-!-margin-bottom-6" style="border: 4px dashed #505a5f; background: #f3f2f1; min-height: 320px; display: flex; flex-direction: column; justify-content: center;">
        <h1 class="govuk-heading-l govuk-!-margin-bottom-3">External job advert</h1>
        <p class="govuk-body-l govuk-!-margin-bottom-3">
          This is a placeholder for the employer’s external application page.
        </p>
        {% if job %}
          <p class="govuk-body govuk-!-margin-bottom-2">
            <strong>{{ job.title }}</strong>{% if job.organisation.name %} at {{ job.organisation.name }}{% endif %}
          </p>
        {% endif %}
        <p class="govuk-body govuk-!-margin-bottom-0">
          In the live service, candidates leave Teaching Vacancies and continue on the organisation’s website.
        </p>
      </div>
      <p class="govuk-body">
        <a class="govuk-link" href="/1-3/home">Return to main site</a>
      </p>
    </div>
  </div>
{% endblock %}
