<!DOCTYPE html>
<html lang="en" class="govuk-template">
<head>
  <meta charset="utf-8">
  <title>Find school and college jobs near you - mobile screen - GOV.UK</title>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <style>
    :root {
      --screen-width: 402px;
      --screen-height: 874px;
      --bezel: 15px;
      --phone-width: calc(var(--screen-width) + (var(--bezel) * 2));
      --phone-height: calc(var(--screen-height) + (var(--bezel) * 2));
    }

    * { box-sizing: border-box; }

    html,
    body {
      height: 100%;
    }

    body {
      margin: 0;
      min-height: 100vh;
      min-height: 100dvh;
      color: #0b0c0c;
      background: #ffffff;
      font-family: "GDS Transport", arial, sans-serif;
      font-size: 19px;
      line-height: 1.45;
    }

    .demo-shell {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      min-height: 100dvh;
      margin: 0;
      padding: 24px;
    }

    .stage {
      flex: 0 0 auto;
      display: flex;
      justify-content: center;
    }

    .phone {
      position: relative;
      width: var(--phone-width);
      height: var(--phone-height);
      padding: var(--bezel);
      border-radius: 54px;
      background:
        linear-gradient(145deg, rgba(255, 255, 255, 0.26), rgba(255, 255, 255, 0.04) 28%),
        linear-gradient(135deg, #2b3340, #06080d 48%, #1b202b);
      box-shadow:
        0 44px 120px rgba(0, 0, 0, 0.58),
        0 18px 42px rgba(0, 0, 0, 0.46),
        inset 0 0 0 1px rgba(255, 255, 255, 0.14);
    }

    .phone::after {
      content: "";
      position: absolute;
      z-index: 3;
      top: 184px;
      right: -3px;
      width: 3px;
      height: 86px;
      border-radius: 0 3px 3px 0;
      background: rgba(255, 255, 255, 0.2);
    }

    .screen {
      position: relative;
      overflow: hidden;
      width: 100%;
      height: 100%;
      border-radius: 46px;
      background: #f1f2f6;
      box-shadow:
        inset 0 0 0 1px rgba(255, 255, 255, 0.18),
        inset 0 0 24px rgba(0, 0, 0, 0.26);
    }

    .screen iframe {
      display: block;
      width: 100%;
      height: 100%;
      border: 0;
      background: #ffffff;
    }

    .home-indicator {
      position: absolute;
      z-index: 3;
      bottom: 8px;
      left: 50%;
      width: 132px;
      height: 5px;
      border-radius: 999px;
      background: rgba(0, 0, 0, 0.72);
      transform: translateX(-50%);
    }

    @media (max-width: 980px) {
      .demo-shell {
        flex-direction: column;
        align-items: center;
        padding: 16px;
      }

      .phone {
        width: min(432px, 100%);
        height: auto;
        aspect-ratio: 432 / 904;
      }
    }
  </style>
</head>
<body>
  <main class="demo-shell">
    <section class="stage">
      <div class="phone">
        <div class="screen">
          <iframe src="/home" title="Teaching Vacancies jobs prototype on a mobile screen"></iframe>
          <span class="home-indicator" aria-hidden="true"></span>
        </div>
      </div>
    </section>
  </main>
</body>
</html>
