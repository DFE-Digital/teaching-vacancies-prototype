{% extends "layout.njk" %}

{% set homepage = true %}
{% set mainClasses = "govuk-!-padding-top-0 govuk-!-padding-bottom-0" %}

{% block pageTitle %}
  Teaching Vacancies Service - GOV.UK
{% endblock %}

{% block header %}
  {{ super() }}
  <header class="homepage-header">
    <div class="govuk-width-container">
      <span class="moj-badge homepage-header__badge">Jobseeker prototype</span>
      <h1 class="homepage-header__title govuk-!-margin-bottom-0">Teaching Vacancies Service</h1>
      <div class="homepage-header__links">
        <p class="homepage-header__link">
          <a class="govuk-link" href="https://manage-teaching-jobs-prototype.herokuapp.com/" rel="noopener noreferrer" target="_blank">
            Hiring staff prototype
            <svg class="homepage-header__external" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M14 3h7v7h-2V6.4l-9.3 9.3-1.4-1.4L17.6 5H14V3z"></path>
              <path fill="currentColor" d="M19 19H5V5h7V3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7h-2v7z"></path>
            </svg>
            <span class="govuk-visually-hidden">(opens in new tab)</span>
          </a>
        </p>
        <p class="homepage-header__link homepage-header__link--end">
          <a class="govuk-link" href="/1-3/documentation">Documentation</a>
          <span class="homepage-header__link-separator" aria-hidden="true">·</span>
          <a class="govuk-link" href="/prototypes/references">Other references</a>
        </p>
      </div>
    </div>
  </header>
{% endblock %}

{% from "includes/prototype-list-macros.njk" import browseActionLink, prototypeVersionCard %}

{% block content %}
  <div class="app-home">
    <div class="govuk-grid-row govuk-!-margin-top-4">
      <div class="govuk-grid-column-full">
        <div class="app-browse-action-links" aria-labelledby="latest-version">
          <h3 class="govuk-heading-m app-browse-action-links__heading" id="latest-version">Current versions</h3>
          <ul class="app-browse-action-links__list">
            {{ browseActionLink("/1-3/home", "Version 1.3") }}
            {{ browseActionLink("/1-2/home", "Version 1.2") }}
            {{ browseActionLink("/1-1/home", "Version 1.1") }}
          </ul>
        </div>

        <div class="app-topic-cards" aria-labelledby="prototype-versions">
          <h3 class="govuk-heading-m app-topic-cards__heading" id="prototype-versions">All versions</h3>
          <ul class="app-topic-cards__list">
            {{ prototypeVersionCard("1.3", "/1-3/home", "/1-3", "2026-10-28", "28 October 2026") }}
            {{ prototypeVersionCard("1.2", "/1-2/home", "/1-2", "2026-10-27", "27 October 2026") }}
            {{ prototypeVersionCard("1.1", "/1-1/home", "/1-1", "2026-10-13", "13 October 2026") }}
            {{ prototypeVersionCard("1.0", "/1-0/home", "/1-0", "2026-10-06", "6 October 2026") }}
          </ul>
        </div>
      </div>
    </div>
  </div>
{% endblock %}
