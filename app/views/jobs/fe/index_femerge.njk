
{% extends "layout.njk" %}

{% block pageTitle %}
 240 jobs found sorted by newest job - Find a job in teaching - Teaching Vacancies - GOV.UK
{% endblock %}

{% set primaryNavId = 'jobs' %}
{% set activeNav = 'jobs' %}
{% set filterFormAction = filterFormAction or '/femerge' %}
{% set clearFiltersHref = clearFiltersHref or '/femerge/clear-filters' %}
{% set showFeSubjects = showFeSubjects or true %}

{% block head %}
  {{ super() }}
  <style>
    .app-search-sort {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 20px;
      margin: 10px 0 20px;
      padding-bottom: 15px;
      border-bottom: 1px solid #b1b4b6;
    }

    .app-search-sort .govuk-heading-m {
      margin-bottom: 0;
    }
  </style>
{% endblock %}

{% block content %}
  <h1 class="govuk-heading-l govuk-!-margin-bottom-6">
    Jobs (341)
  </h1>

  <p><a class="govuk-link govuk-link--no-visited-state" href="alert?role-type=fe-role">Receive a job alert</a> whenever new jobs match your search.</p>

  <div class="app-filter-layout">
    <div class="app-filter-layout__filter">

      {% if data['filtertype'] == '1' %}

        {% include "includes/jobs-filter-panel-collapsible.njk" %}

      {% elseif data['filtertype'] == '2' %}

        {% include "includes/jobs-filter-panel.njk" %}

      {% else %}

        {% include "includes/jobs-filter-panel-collapsible.njk" %}

      {% endif %}

    </div>


    <div class="app-filter-layout__content">
      {% include "includes/jobs-search-form.njk" %}

      <div class="app-action-bar">
        <div class="app-action-bar__filter"></div>
      </div>

      <div>
        <div class="app-jobs">

          {% if data['sort'] == 'newest' %}
            {% set currentSort = 'newest' %}
          {% else %}
            {% set currentSort = 'ending' %}
          {% endif %}

          <div class="app-search-sort">
            <h2 class="govuk-heading-m">
              {% if currentSort == 'newest' %}
                Sorted by newest job
              {% else %}
                Sorted by ending soon
              {% endif %}
            </h2>
            <form id="sortform" method="get" action="/femerge" data-sort-stay="true">
              <div class="govuk-form-group govuk-!-margin-bottom-0">
                <label class="govuk-label" for="sort">Sort by</label>
                <select class="govuk-select" id="sort" name="sort">
                  <option value="ending" {% if currentSort == 'ending' %}selected{% endif %}>Ending soon</option>
                  <option value="newest" {% if currentSort == 'newest' %}selected{% endif %}>Newest job</option>
                </select>
              </div>
            </form>
          </div>

        {% if currentSort == 'newest' %}
          {% set job_list = jobs|sort(attribute='publishDate', reverse=true) %}
        {% else %}
          {% set job_list = jobs|sort(attribute='closingDate', reverse=false) %}
        {% endif %}

        {% for job in job_list %}

          {% if loop.index0 < 10 %}

            {% set address %}
              {% for part, value in job.organisation.address %}
                {{value}}{% if not loop.last %}, {% endif %}
              {% endfor %}
            {% endset %}

            {% set closingInformation %}
              {{job.closingDate | date}} at {{job.closingTime}}
            {% endset %}

            <div class="app-jobs__item">
              <h2 class="govuk-heading-m">

                <a href="/jobs/{{job.id}}">{{job.title}}</a>&nbsp;

                {% if job.isUsingApplicationForm == 'Yes' %}
                  <a class="govuk-tag govuk-tag--green" href="/jobs/{{ job.id }}/apply">Quick apply</a>
                {% endif %}

              </h2>

              <p class="app-jobs__address">{{job.organisation.name}},{{address}}</p>

              {{ govukSummaryList({
                classes: 'govuk-summary-list--no-border app-summary-list--compact',
                rows: [
                  {
                    key: {
                      text: "Full-time equivalent salary"
                    },
                    value: {
                      html: job.fullTimeEquivalentSalaryDetails
                    }
                  } if job.fullTimeEquivalentSalaryDetails,
                  {
                    key: {
                      text: "Actual salary"
                    },
                    value: {
                      html: job.actualSalaryDetails
                    }
                  } if job.actualSalaryDetails,
                  {
                    key: {
                      text: "Pay scale"
                    },
                    value: {
                      html: job.payScaleDetails
                    }
                  } if job.payScaleDetails,
                  {
                    key: {
                      text: "School type"
                    },
                    value: {
                      html: job.schoolType
                    }
                  } if job.schoolType,
                  {
                    key: {
                      text: "Working pattern"
                    },
                    value: {
                      text: job.workingPatterns | join(', ') | capitalize
                    }
                  },
                  {
                    key: {
                      text: "Closing date"
                    },
                    value: {
                      html: closingInformation
                    }
                  } if job.closingDate,
                  {
                    key: {
                      text: "Visa sponsorship"
                    },
                    value: {
                      text: job.sponsorship
                    }
                  } if job.sponsorship
                ]
              }) }}
            </div>

          {% endif %}
        {% endfor %}
      </div>

      {{ govukPagination({
          next: {
            href: "#"
          },
          items: [
            {
              number: 1,
              href: "#",
              current: true
            },
            {
              number: 2,
              href: "#"
            },
            {
              number: 3,
              href: "#"
            }
          ]
        }) }}
    </div>
  </div>

  {# {{ govukDetails({
    summaryText: "Jobs by school, role, location and subject",
    text: "Text",
    classes: 'govuk-!-margin-top-8 govuk-!-margin-bottom-0'
  }) }} #}

{% endblock %}

{% block pageScripts %}
  <script src="/public/javascripts/components/filter-toggle-button/filter-toggle-button.js"></script>
  <script>
    new AppFrontend.FilterToggleButton({
      bigModeMediaQuery: '(min-width: 48.063em)',
      startHidden: false,
      toggleButton: {
        container: $('.app-action-bar__filter'),
        showText: 'Show filter',
        hideText: 'Hide filter',
        classes: 'govuk-button--secondary govuk-!-margin-bottom-3'
      },
      closeButton: {
        container: $('.app-filter__header-action'),
        text: 'Close'
      },
      filter: {
        container: $('.app-filter-layout__filter')
      }
    })

    new AppFrontend.CheckboxFilter({
      container: $('#subjects'),
      textBox: {
        label: 'Search for subject'
      }
    })
  </script>
{% endblock %}
