{% extends "layout_femerge.njk" %}

{% set title = 'Subjects (optional)' %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <a href="/fe/job-title" class="govuk-back-link">Back</a>

{% if errors %}
  {{ govukErrorSummary({
    titleText: "There is a problem",
    errorList: [
      {
        text: errors.subjects,
        href: "#feJob-subject-search"
      } if errors.subjects
    ]
  }) }}
{% endif %}
      

      <span class="govuk-caption-l">Create a job listing - section 1 of 4</span>

      <form method="post" novalidate>
        <div class="govuk-form-group{% if errors.subjects %} govuk-form-group--error{% endif %}">
          <label class="govuk-label govuk-label--xl" for="feJob-subject-search">
            {{ title }}
          </label>
          <div id="feJob-subject-search-hint" class="govuk-hint">
            Start typing a subject, then select it from the list. Leave this blank if the subject is not listed.
          </div>
          {% if errors.subjects %}
            <p id="feJob-subject-search-error" class="govuk-error-message">
              <span class="govuk-visually-hidden">Error:</span> {{ errors.subjects }}
            </p>
          {% endif %}
          <input class="govuk-input{% if errors.subjects %} govuk-input--error{% endif %}" id="feJob-subject-search" name="feJob[subjectSearch]" type="text" value="{{ job.subjectSearch }}" aria-describedby="feJob-subject-search-hint{% if errors.subjects %} feJob-subject-search-error{% endif %}" autocomplete="off">
        </div>

        <div class="govuk-form-group">
          <fieldset class="govuk-fieldset">
            <legend class="govuk-fieldset__legend govuk-visually-hidden">
              Subject list
            </legend>
            <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes" id="fe-subject-list" style="max-height: 280px; overflow-y: auto; border-bottom: 1px solid #b1b4b6;">
              {% for subject in subjects %}
                <div class="govuk-checkboxes__item" data-subject="{{ subject.text | lower }}">
                  <input class="govuk-checkboxes__input" id="feJob-subjects-{{ loop.index }}" name="feJob[subjects]" type="checkbox" value="{{ subject.value }}"{% if subject.value in job.subjects %} checked{% endif %}>
                  <label class="govuk-label govuk-checkboxes__label" for="feJob-subjects-{{ loop.index }}">
                    {{ subject.text }}
                  </label>
                  {% if subject.hint %}
                    <div class="govuk-hint govuk-checkboxes__hint">
                      {{ subject.hint }}
                    </div>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          </fieldset>
        </div>

        <div class="govuk-button-group">
          {{ govukButton({
            text: "Save and continue"
          }) }}
          <button type="button" class="govuk-button govuk-button--secondary" data-module="govuk-button">
            Save and finish later
          </button>
        </div>
      </form>

      <p class="govuk-body">
        <a href="#" class="govuk-link">Cancel</a>
      </p>

      {% if job.subjects and job.subjects.length %}
        <h2 class="govuk-heading-m govuk-!-margin-top-9 govuk-!-margin-bottom-3">Subject List</h2>
        <ul class="govuk-list">
          {% for subject in job.subjects %}
            <li>{{ subject }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
{% endblock %}

{% block pageScripts %}
  <script>
    var subjectSearch = document.getElementById('feJob-subject-search');
    var subjectItems = document.querySelectorAll('#fe-subject-list .govuk-checkboxes__item');

    if (subjectSearch && subjectItems.length) {
      function filterSubjects() {
        var searchTerm = subjectSearch.value.trim().toLowerCase();

        subjectItems.forEach(function (item) {
          var subject = item.getAttribute('data-subject');
          item.style.display = searchTerm && subject.indexOf(searchTerm) === -1 ? 'none' : '';
        });
      }

      subjectSearch.addEventListener('input', filterSubjects);
      filterSubjects();
    }
  </script>
{% endblock %}
